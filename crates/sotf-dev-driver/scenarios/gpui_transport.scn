# GPUI Transport controls — play/stop/next/prev/volume/mute.
#
# Covers: PlayPause, Stop, NextTrack, PrevTrack, VolumeUp, VolumeDown,
#         ToggleMute, VolumeMax, VolumeMin

focus       library
assert      screen.focused == "Library"
assert      playback.is_playing == false
assert      queue.length == 0

# The suite seeds demo audio for this scenario. Add the selected album before
# testing PlayPause; empty-queue PlayPause is intentionally a no-op.
action      AddToQueue
wait_until  queue.length > 0 timeout=2s

# Playback controls.
action      PlayPause
wait_until  playback.is_playing == true timeout=2s

action      Stop
wait_until  playback.is_playing == false timeout=2s

action      NextTrack
sleep       100ms
action      PrevTrack
sleep       100ms

# Volume nudges.
action      VolumeUp
sleep       100ms
action      VolumeDown
sleep       100ms

# Mute toggle.
action      ToggleMute
sleep       100ms
assert      playback.muted == true

action      ToggleMute
sleep       100ms
assert      playback.muted == false

# Volume extremes.
action      VolumeMax
sleep       100ms
action      VolumeMin
sleep       100ms

# Desktop Now Playing must expose the same queue traversal policy as phone.
# Exercise painted controls rather than only dispatching state actions.
click      sidebar.nav-playing
assert     screen.focused == "NowPlaying"
assert     playback.shuffle == false
assert     playback.repeat == false
assert_visible transport.shuffle
assert_visible transport.repeat
assert_accessible button Shuffle
assert_accessible button Repeat
click      transport.shuffle
wait_until playback.shuffle == true timeout=2s
click      transport.repeat
wait_until playback.repeat == true timeout=2s
click      transport.shuffle
wait_until playback.shuffle == false timeout=2s
click      transport.repeat
wait_until playback.repeat == false timeout=2s
accessibility
screenshot now-playing-transport
