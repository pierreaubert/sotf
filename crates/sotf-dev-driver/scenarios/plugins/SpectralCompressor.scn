# SpectralCompressor plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add SpectralCompressor
assert plugins.count > 0
assert plugins.plugin.2.type == "SpectralCompressor"

# 12 parameter(s)
plugin_param_set 2 0 1.0
plugin_param_set 2 1 -42.0
plugin_param_set 2 2 6.7
plugin_param_set 2 3 30.07
plugin_param_set 2 4 307.0
plugin_param_set 2 5 6.0
plugin_param_set 2 6 0.3
plugin_param_set 2 7 0.3
plugin_param_set 2 8 1.0
plugin_param_set 2 9 1.0
plugin_param_set 2 10 1.0
plugin_param_set 2 11 -8.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/SpectralCompressor.json
plugin_remove 2
assert plugins.plugin.2.type != "SpectralCompressor"
plugin_chain_load $SOTF_QA_DIR/SpectralCompressor.json
assert plugins.plugin.2.type == "SpectralCompressor"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "SpectralCompressor"
