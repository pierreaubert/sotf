# StereoImager plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add StereoImager
assert plugins.count > 0
assert plugins.plugin.2.type == "Stereo Imager"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-StereoImager

# 8 parameter(s)
plugin_param_set 2 0 0.6
plugin_param_set 2 1 356.0
plugin_param_set 2 2 5500.0
plugin_param_set 2 3 0.6
plugin_param_set 2 4 0.6
plugin_param_set 2 5 0.6
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.3

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/StereoImager.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/StereoImager.json
assert plugins.plugin.2.type == "Stereo Imager"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
