# Limiter plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Limiter
assert plugins.count > 0
assert plugins.plugin.2.type == "Limiter"

# 10 parameter(s)
plugin_param_set 2 0 -14.0
plugin_param_set 2 1 307.0
plugin_param_set 2 2 6.0
plugin_param_set 2 3 1.0
plugin_param_set 2 4 1.0
plugin_param_set 2 5 1.0
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.3
plugin_param_set 2 8 0.3
plugin_param_set 2 9 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Limiter.json
plugin_remove 2
assert plugins.plugin.2.type != "Limiter"
plugin_chain_load $SOTF_QA_DIR/Limiter.json
assert plugins.plugin.2.type == "Limiter"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Limiter"
