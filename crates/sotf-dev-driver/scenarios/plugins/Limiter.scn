# Limiter plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Limiter
assert plugins.count > 0
assert plugins.plugin.2.type == "Limiter"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Limiter

# Primary True Peak detection remains directly reachable at narrow widths.
assert plugins.plugin.2.param_count == 10
assert_in_viewport plugin.choice.2.4.1
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
assert plugins.plugin.2.param.5.value == 0
click plugin.choice.2.4.0
assert plugins.plugin.2.param.4.value == 0
screenshot editor-Limiter-primary

# 10 parameter(s)
plugin_param_set 2 0 -14.0
plugin_param_set 2 1 307.0
plugin_param_set 2 2 6.0
plugin_param_set 2 3 1.0
plugin_param_set 2 4 1.0
plugin_param_set 2 5 1.0
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.3
plugin_param_set 2 8 0.3
plugin_param_set 2 9 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Limiter.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Limiter.json
assert plugins.plugin.2.type == "Limiter"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
