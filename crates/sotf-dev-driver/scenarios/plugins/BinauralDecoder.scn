# BinauralDecoder plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add BinauralDecoder
assert plugins.count > 0
assert plugins.plugin.2.type == "BinauralDecoder"

# 9 parameter(s)
# skipping file parameter 0: SOFA File
plugin_param_set 2 1 6.2
plugin_param_set 2 2 0.3
plugin_param_set 2 3 0.3
plugin_param_set 2 4 1.0
plugin_param_set 2 5 1.0
plugin_param_set 2 6 0.3
plugin_param_set 2 7 1.57
plugin_param_set 2 8 0.3

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/BinauralDecoder.json
plugin_remove 2
assert plugins.plugin.2.type != "BinauralDecoder"
plugin_chain_load $SOTF_QA_DIR/BinauralDecoder.json
assert plugins.plugin.2.type == "BinauralDecoder"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "BinauralDecoder"
