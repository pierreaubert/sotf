# Saturation plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Saturation
assert plugins.count > 0
assert plugins.plugin.2.type == "Saturation"

# 12 parameter(s)
plugin_param_set 2 0 1.0
plugin_param_set 2 1 6.7
plugin_param_set 2 2 1.6
plugin_param_set 2 3 3350.0
plugin_param_set 2 4 1.0
plugin_param_set 2 5 -4.800000000000001
plugin_param_set 2 6 0.3
plugin_param_set 2 7 0.3
plugin_param_set 2 8 30.07
plugin_param_set 2 9 150.7
plugin_param_set 2 10 1.0
plugin_param_set 2 11 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Saturation.json
plugin_remove 2
assert plugins.plugin.2.type != "Saturation"
plugin_chain_load $SOTF_QA_DIR/Saturation.json
assert plugins.plugin.2.type == "Saturation"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Saturation"
