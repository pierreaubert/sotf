# Gain plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Gain
assert plugins.count > 0
assert plugins.plugin.2.type == "Gain"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Gain
assert_accessible spinbutton Gain value
assert_accessible slider Gain
assert_accessible spinbutton Smoothing value
assert_accessible slider Smoothing

# The unity reference remains available after editing the gain.
assert_in_viewport plugin.gain.2.unity
action IncrementPluginParam
assert plugins.plugin.2.param.0.value > 0
click plugin.gain.2.unity
assert plugins.plugin.2.param.0.value == 0 tolerance=0.001
assert plugins.plugin.2.param.1.value == 10 tolerance=0.001
screenshot editor-Gain-unity

# 2 parameter(s)
plugin_param_set 2 0 -36.0
plugin_param_set 2 1 30.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Gain.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Gain.json
assert plugins.plugin.2.type == "Gain"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
