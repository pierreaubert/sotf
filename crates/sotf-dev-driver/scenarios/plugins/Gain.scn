# Gain plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Gain
assert plugins.count > 0
assert plugins.plugin.2.type == "Gain"

# 2 parameter(s)
plugin_param_set 2 0 -36.0
plugin_param_set 2 1 30.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Gain.json
plugin_remove 2
assert plugins.plugin.2.type != "Gain"
plugin_chain_load $SOTF_QA_DIR/Gain.json
assert plugins.plugin.2.type == "Gain"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Gain"
