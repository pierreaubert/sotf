# Crossfeed plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Crossfeed
assert plugins.count > 0
assert plugins.plugin.2.type == "Crossfeed"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Crossfeed

# 17 parameter(s)
plugin_param_set 2 0 1.0
plugin_param_set 2 1 1.0
plugin_param_set 2 2 1.0
plugin_param_set 2 3 0.3
plugin_param_set 2 4 580.0
plugin_param_set 2 5 4.5
plugin_param_set 2 6 30.0
plugin_param_set 2 7 185.0
plugin_param_set 2 8 5900.0
plugin_param_set 2 9 -14.0
plugin_param_set 2 10 4.5
plugin_param_set 2 11 4.5
plugin_param_set 2 12 0.3
plugin_param_set 2 13 1.0
plugin_param_set 2 14 -31.6
plugin_param_set 2 15 7.199999999999999
plugin_param_set 2 16 1507.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Crossfeed.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Crossfeed.json
assert plugins.plugin.2.type == "Crossfeed"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
