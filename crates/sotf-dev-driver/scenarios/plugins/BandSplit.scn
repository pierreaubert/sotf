# BandSplit plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add BandSplit
assert plugins.count > 0
assert plugins.plugin.2.type == "Band Split"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-BandSplit

# 2 parameter(s)
plugin_param_set 2 0 6014.0
plugin_param_set 2 1 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/BandSplit.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/BandSplit.json
assert plugins.plugin.2.type == "Band Split"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
