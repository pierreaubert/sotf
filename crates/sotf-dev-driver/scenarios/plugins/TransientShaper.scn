# TransientShaper plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add TransientShaper
assert plugins.count > 0
assert plugins.plugin.2.type == "Transient Shaper"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-TransientShaper

# 5 parameter(s)
plugin_param_set 2 0 -40.0
plugin_param_set 2 1 -40.0
plugin_param_set 2 2 -4.800000000000001
plugin_param_set 2 3 -4.800000000000001
plugin_param_set 2 4 0.3

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/TransientShaper.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/TransientShaper.json
assert plugins.plugin.2.type == "Transient Shaper"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
