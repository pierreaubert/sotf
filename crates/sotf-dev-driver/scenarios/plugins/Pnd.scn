# Pnd plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Pnd
assert plugins.count > 0
assert plugins.plugin.2.type == "PND Varispeed"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Pnd
assert plugins.plugin.2.param_count == 8
plugin_param_set 2 5 0
wait_idle
scroll rack.params 5000
screenshot pnd-change-only-tracking
plugin_param_set 2 5 440
wait_idle
screenshot pnd-fixed-reference

# Primary parameters and reference-mode presentation; 8 parameters total.
plugin_param_set 2 0 0.6
plugin_param_set 2 1 164.0
plugin_param_set 2 2 0.30069999999999997
plugin_param_set 2 3 1.0
plugin_param_set 2 4 0.3
plugin_param_set 2 5 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Pnd.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Pnd.json
assert plugins.plugin.2.type == "PND Varispeed"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
