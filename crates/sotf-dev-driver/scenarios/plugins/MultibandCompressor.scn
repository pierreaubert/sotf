# MultibandCompressor plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add MultibandCompressor
assert plugins.count > 0
assert plugins.plugin.2.type == "MultibandCompressor"

# 17 parameter(s)
plugin_param_set 2 0 2.9
plugin_param_set 2 1 0.8999999999999999
plugin_param_set 2 2 164.0
plugin_param_set 2 3 1850.0
plugin_param_set 2 4 8000.0
plugin_param_set 2 5 12400.0
plugin_param_set 2 6 -42.0
plugin_param_set 2 7 6.7
plugin_param_set 2 8 30.07
plugin_param_set 2 9 307.0
plugin_param_set 2 10 6.0
plugin_param_set 2 11 0.3
plugin_param_set 2 12 1.0
plugin_param_set 2 13 6.0
plugin_param_set 2 14 1.0
plugin_param_set 2 15 -2.4000000000000004
plugin_param_set 2 16 0.3

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/MultibandCompressor.json
plugin_remove 2
assert plugins.plugin.2.type != "MultibandCompressor"
plugin_chain_load $SOTF_QA_DIR/MultibandCompressor.json
assert plugins.plugin.2.type == "MultibandCompressor"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "MultibandCompressor"
