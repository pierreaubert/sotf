# Declick plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Declick
assert plugins.count > 0
assert plugins.plugin.2.type == "Declick"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Declick

# 2 parameter(s)
plugin_param_set 2 0 1.0
plugin_param_set 2 1 30.7

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Declick.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Declick.json
assert plugins.plugin.2.type == "Declick"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
