# Convolution plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Convolution
assert plugins.count > 0
assert plugins.plugin.2.type == "Convolution"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Convolution

# 6 parameter(s)
# skipping file parameter 0: IR File
plugin_param_set 2 1 0.3
plugin_param_set 2 2 -8.0
plugin_param_set 2 3 1.0
plugin_param_set 2 4 1.0
plugin_param_set 2 5 176.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Convolution.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Convolution.json
assert plugins.plugin.2.type == "Convolution"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
