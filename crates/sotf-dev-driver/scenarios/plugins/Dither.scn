# Dither reference controls: bit depth, noise shaping, quantization mode.
# Primary control interaction plus parameter/preset lifecycle.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Dither
assert plugins.plugin.2.type == "Dither"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Dither
assert plugins.plugin.2.param_count == 3
scroll_into_view rack.params plugin.choice.2.0.1
click plugin.choice.2.0.1
assert plugins.plugin.2.param.0.value == 1
# Establish keyboard focus, then advance to the following choice.
key tab
wait_idle
assert_focused btn-set-2-0-1
key tab
wait_idle
assert_focused btn-set-2-0-2
key enter
wait_idle
assert plugins.plugin.2.param.0.value == 2
assert plugins.plugin.2.enabled == true
scroll_into_view rack.params plugin.choice.2.0.2
click plugin.choice.2.0.2
assert plugins.plugin.2.param.0.value == 2
scroll_into_view rack.params plugin.choice.2.0.0
click plugin.choice.2.0.0
assert plugins.plugin.2.param.0.value == 0
scroll_into_view rack.params plugin.choice.2.2.1
click plugin.choice.2.2.1
assert plugins.plugin.2.param.2.value == 1
scroll_into_view rack.params plugin.choice.2.2.2
click plugin.choice.2.2.2
assert plugins.plugin.2.param.2.value == 2
scroll_into_view rack.params plugin.choice.2.2.0
click plugin.choice.2.2.0
assert plugins.plugin.2.param.2.value == 0
scroll_into_view rack.params plugin.choice.2.1.0
click plugin.choice.2.1.0
assert plugins.plugin.2.param.1.value == 0
scroll_into_view rack.params plugin.choice.2.1.1
click plugin.choice.2.1.1
assert plugins.plugin.2.param.1.value == 1
screenshot dither-primary-controls
plugin_param_set 2 0 2
plugin_param_set 2 1 0
plugin_param_set 2 2 2
assert plugins.plugin.2.param.0.value == 2
assert plugins.plugin.2.param.1.value == 0
assert plugins.plugin.2.param.2.value == 2
plugin_chain_save $SOTF_QA_DIR/Dither.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Dither.json
assert plugins.plugin.2.type == "Dither"
assert plugins.plugin.2.param.0.value == 2
assert plugins.plugin.2.param.1.value == 0
assert plugins.plugin.2.param.2.value == 2
plugin_remove 2
assert plugins.user_count == 0
