# AmbisonicsDecoder plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add AmbisonicsDecoder
assert plugins.count > 0
assert plugins.plugin.2.type == "AmbisonicsDecoder"

# 4 parameter(s)
plugin_param_set 2 0 1.6
plugin_param_set 2 1 1.0
plugin_param_set 2 2 1.0
plugin_param_set 2 3 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/AmbisonicsDecoder.json
plugin_remove 2
assert plugins.plugin.2.type != "AmbisonicsDecoder"
plugin_chain_load $SOTF_QA_DIR/AmbisonicsDecoder.json
assert plugins.plugin.2.type == "AmbisonicsDecoder"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "AmbisonicsDecoder"
