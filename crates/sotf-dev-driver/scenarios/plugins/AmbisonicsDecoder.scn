# AmbisonicsDecoder plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
action PluginSetInputChannels {"channels":4}
plugin_add AmbisonicsDecoder
assert plugins.count > 0
assert plugins.plugin.2.type == "Ambisonics Decoder"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-AmbisonicsDecoder

# 4 parameter(s)
plugin_param_set 2 0 1.6
plugin_param_set 2 1 1.0
plugin_param_set 2 2 1.0
plugin_param_set 2 3 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/AmbisonicsDecoder.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/AmbisonicsDecoder.json
assert plugins.plugin.2.type == "Ambisonics Decoder"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
