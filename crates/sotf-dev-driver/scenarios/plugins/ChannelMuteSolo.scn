# ChannelMuteSolo plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add ChannelMuteSolo
assert plugins.count > 0
assert plugins.plugin.2.type == "ChannelMuteSolo"

# 3 parameter(s)
plugin_param_set 2 0 1.0
plugin_param_set 2 1 -42.0
plugin_param_set 2 2 30.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/ChannelMuteSolo.json
plugin_remove 2
assert plugins.plugin.2.type != "ChannelMuteSolo"
plugin_chain_load $SOTF_QA_DIR/ChannelMuteSolo.json
assert plugins.plugin.2.type == "ChannelMuteSolo"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "ChannelMuteSolo"
