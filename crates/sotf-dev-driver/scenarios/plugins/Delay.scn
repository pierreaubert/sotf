# Delay plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Delay
assert plugins.count > 0
assert plugins.plugin.2.type == "Delay"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Delay

assert plugins.plugin.2.param_count == 8
assert_accessible spinbutton Delay value
assert_accessible slider Feedback
assert_accessible slider Mix
accessibility
scroll_into_view rack.params plugin.choice.2.7.1
assert plugins.plugin.2.param.1.value == 0.3 tolerance=0.001
assert_in_viewport plugin.choice.2.7.1
click plugin.choice.2.7.1
assert plugins.plugin.2.param.7.value == 1
click plugin.choice.2.7.0
assert plugins.plugin.2.param.7.value == 0
screenshot editor-Delay-details

# 8 parameter(s), including pitch-preserving mode (off with active LFO).
plugin_param_set 2 0 1500.0
plugin_param_set 2 1 -0.38
plugin_param_set 2 2 0.3
plugin_param_set 2 3 6.0
plugin_param_set 2 4 3.0
plugin_param_set 2 5 0.297
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Delay.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Delay.json
assert plugins.plugin.2.type == "Delay"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
