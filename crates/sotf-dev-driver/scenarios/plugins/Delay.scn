# Delay plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Delay
assert plugins.count > 0
assert plugins.plugin.2.type == "Delay"

# 7 parameter(s)
plugin_param_set 2 0 1500.0
plugin_param_set 2 1 -0.38
plugin_param_set 2 2 0.3
plugin_param_set 2 3 6.0
plugin_param_set 2 4 3.0
plugin_param_set 2 5 0.297
plugin_param_set 2 6 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Delay.json
plugin_remove 2
assert plugins.plugin.2.type != "Delay"
plugin_chain_load $SOTF_QA_DIR/Delay.json
assert plugins.plugin.2.type == "Delay"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Delay"
