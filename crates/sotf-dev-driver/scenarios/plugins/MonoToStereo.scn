# MonoToStereo plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add MonoToStereo
assert plugins.count > 0
assert plugins.plugin.2.type == "MonoToStereo"

# 5 parameter(s)
plugin_param_set 2 0 0.3
plugin_param_set 2 1 1.5
plugin_param_set 2 2 220.0
plugin_param_set 2 3 2200.0
plugin_param_set 2 4 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/MonoToStereo.json
plugin_remove 2
assert plugins.plugin.2.type != "MonoToStereo"
plugin_chain_load $SOTF_QA_DIR/MonoToStereo.json
assert plugins.plugin.2.type == "MonoToStereo"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "MonoToStereo"
