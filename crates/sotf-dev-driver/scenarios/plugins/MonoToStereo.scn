# MonoToStereo plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
action PluginSetInputChannels {"channels":1}
plugin_add MonoToStereo
assert plugins.count > 0
assert plugins.plugin.2.type == "Mono to Stereo"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-MonoToStereo
# The selected parameter uses the exact input instead of its rotary slider.
assert_visible plugin.param.2.0.exact
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "0.65"
key enter
wait_idle
assert plugins.plugin.2.param.0.value == 0.65 tolerance=0.001
assert plugins.plugin.2.enabled == true
assert_accessible slider Haas Delay
scroll_into_view rack.params plugin.choice.2.4.0
click plugin.choice.2.4.0
assert plugins.plugin.2.param.4.value == 0
click plugin.choice.2.4.1
assert plugins.plugin.2.param.4.value == 1
screenshot mono-primary-controls

# 5 parameter(s)
plugin_param_set 2 0 0.3
plugin_param_set 2 1 1.5
plugin_param_set 2 2 220.0
plugin_param_set 2 3 2200.0
plugin_param_set 2 4 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/MonoToStereo.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/MonoToStereo.json
assert plugins.plugin.2.type == "Mono to Stereo"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
