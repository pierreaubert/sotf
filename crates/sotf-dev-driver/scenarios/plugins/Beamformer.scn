# Beamformer plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Beamformer
assert plugins.count > 0
assert plugins.plugin.2.type == "Beamformer"

# 4 parameter(s)
plugin_param_set 2 0 3.8
plugin_param_set 2 1 15.7
plugin_param_set 2 2 -72.0
plugin_param_set 2 3 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Beamformer.json
plugin_remove 2
assert plugins.plugin.2.type != "Beamformer"
plugin_chain_load $SOTF_QA_DIR/Beamformer.json
assert plugins.plugin.2.type == "Beamformer"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Beamformer"
