# Aec plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Aec
assert plugins.count > 0
assert plugins.plugin.2.type == "AEC"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Aec

# 3 parameter(s)
plugin_param_set 2 0 185.0
plugin_param_set 2 1 0.33999999999999997
plugin_param_set 2 2 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Aec.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Aec.json
assert plugins.plugin.2.type == "AEC"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
