# LoudnessCompensation plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add LoudnessCompensation
assert plugins.count > 0
assert plugins.plugin.2.type == "LoudnessCompensation"

# 15 parameter(s)
plugin_param_set 2 0 164.0
plugin_param_set 2 1 -8.0
plugin_param_set 2 2 7400.0
plugin_param_set 2 3 -8.0
plugin_param_set 2 4 1.0
plugin_param_set 2 5 2750.0
plugin_param_set 2 6 -8.0
plugin_param_set 2 7 1.57
plugin_param_set 2 8 1.0
plugin_param_set 2 9 7.199999999999999
plugin_param_set 2 10 300.7
plugin_param_set 2 11 1.0
plugin_param_set 2 12 55.0
plugin_param_set 2 13 72.0
plugin_param_set 2 14 -56.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/LoudnessCompensation.json
plugin_remove 2
assert plugins.plugin.2.type != "LoudnessCompensation"
plugin_chain_load $SOTF_QA_DIR/LoudnessCompensation.json
assert plugins.plugin.2.type == "LoudnessCompensation"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "LoudnessCompensation"
