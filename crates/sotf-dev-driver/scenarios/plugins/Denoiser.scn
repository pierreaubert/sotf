# Denoiser plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Denoiser
assert plugins.count > 0
assert plugins.plugin.2.type == "Denoiser"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Denoiser

# 2026-09-09: custom-view width cutoff hid all controls at 600x1000/150%.
# Fix: components/plugins/mod.rs::render_plugin_content uses the wrapping
# minimum for Denoiser. Run the plugin_reference_followup_ui.toml suite
# through sotf-dev-driver run-suite; the runner creates isolated QA dirs.
# Profile actions belong to the primary editor, not the collapsed details.
assert_visible plugin.control.2.20
assert_visible plugin.control.2.21
assert_visible plugin.control.2.22

# 29 parameter(s)
plugin_param_set 2 0 12.0
plugin_param_set 2 1 -45.0
plugin_param_set 2 2 0.297
plugin_param_set 2 3 30.07
plugin_param_set 2 4 157.0
plugin_param_set 2 5 1.0
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.647
plugin_param_set 2 8 0.367
plugin_param_set 2 9 67.0
plugin_param_set 2 10 6.7
plugin_param_set 2 11 0.3
plugin_param_set 2 12 1.0
plugin_param_set 2 13 0.6496999999999999
plugin_param_set 2 14 1.0
plugin_param_set 2 15 1.0
plugin_param_set 2 16 1.0
plugin_param_set 2 17 1.0
plugin_param_set 2 18 2.15
plugin_param_set 2 19 0.1507
plugin_param_set 2 20 1.0
plugin_param_set 2 21 1.0
plugin_param_set 2 22 1.0
plugin_param_set 2 23 1.0
plugin_param_set 2 24 0.3
plugin_param_set 2 25 1.0
plugin_param_set 2 26 1.0
plugin_param_set 2 27 1.0
plugin_param_set 2 28 0.3

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Denoiser.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Denoiser.json
assert plugins.plugin.2.type == "Denoiser"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
