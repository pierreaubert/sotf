# LinearPhaseEq plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add LinearPhaseEq
assert plugins.count > 0
assert plugins.plugin.2.type == "LinearPhaseEq"

# 21 parameter(s); phase mode 1 exercises the consolidated minimum-phase path.
plugin_param_set 2 0 3.6999999999999997
plugin_param_set 2 1 1.0
plugin_param_set 2 2 1.0
plugin_param_set 2 3 1.0
plugin_param_set 2 4 0.3
# stopping at parameter 5: query out of range

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/LinearPhaseEq.json
plugin_remove 2
assert plugins.plugin.2.type != "LinearPhaseEq"
plugin_chain_load $SOTF_QA_DIR/LinearPhaseEq.json
assert plugins.plugin.2.type == "LinearPhaseEq"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "LinearPhaseEq"
