# AAE plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add AAE
assert plugins.count > 0
assert plugins.plugin.2.type == "AAE"

# 25 parameter(s)
plugin_param_set 2 0 1.0
plugin_param_set 2 1 1.04
plugin_param_set 2 2 2.01
plugin_param_set 2 3 1.1600000000000001
plugin_param_set 2 4 0.44
plugin_param_set 2 5 30.0
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.3
plugin_param_set 2 8 0.3
plugin_param_set 2 9 0.3
plugin_param_set 2 10 0.3
plugin_param_set 2 11 0.3
plugin_param_set 2 12 0.3
plugin_param_set 2 13 0.3
plugin_param_set 2 14 0.3
plugin_param_set 2 15 0.3
plugin_param_set 2 16 1.0
plugin_param_set 2 17 3.5999999999999996
plugin_param_set 2 18 3.5999999999999996
plugin_param_set 2 19 1.0
plugin_param_set 2 20 7.199999999999999
plugin_param_set 2 21 157.0
plugin_param_set 2 22 1.0
plugin_param_set 2 23 1.0
plugin_param_set 2 24 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/AAE.json
plugin_remove 2
assert plugins.plugin.2.type != "AAE"
plugin_chain_load $SOTF_QA_DIR/AAE.json
assert plugins.plugin.2.type == "AAE"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "AAE"
