# BandMerge plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add BandMerge
assert plugins.count > 0
assert plugins.plugin.2.type == "Band Merge"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-BandMerge

# 1 parameter(s)
# Four bands/microphones require a matching four-channel source fixture.
action PluginSetInputChannels {"channels":4}
plugin_param_set 2 0 4
assert plugins.plugin.2.param.0.value == 4

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/BandMerge.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/BandMerge.json
assert plugins.plugin.2.type == "Band Merge"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
