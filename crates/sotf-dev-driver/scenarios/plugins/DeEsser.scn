# DeEsser plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add DeEsser
assert plugins.count > 0
assert plugins.plugin.2.type == "DeEsser"

# 8 parameter(s)
plugin_param_set 2 0 6200.0
plugin_param_set 2 1 1.8499999999999999
plugin_param_set 2 2 -42.0
plugin_param_set 2 3 6.7
plugin_param_set 2 4 3.0700000000000003
plugin_param_set 2 5 63.5
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.3

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/DeEsser.json
plugin_remove 2
assert plugins.plugin.2.type != "DeEsser"
plugin_chain_load $SOTF_QA_DIR/DeEsser.json
assert plugins.plugin.2.type == "DeEsser"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "DeEsser"
