# FletcherMunson plugin lifecycle scenario
# Mode visibility, exact reference entry, and preset persistence; live volume/calibration acceptance remains separate.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add FletcherMunson
assert plugins.count > 0
assert plugins.plugin.2.type == "Loudness Compensation"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-FletcherMunson

# The alias must preserve its application default, not the raw shared schema default.
assert plugins.plugin.2.param_count == 18
assert plugins.plugin.2.param.11.value == 2

# Manual contour controls are replaced by level/reference controls in ISO mode.
scroll_into_view rack.params plugin.choice.2.11.0
click plugin.choice.2.11.0
wait_idle
assert plugins.plugin.2.param.11.value == 0
assert_visible plugin.param.2.0.exact
assert_accessible slider High Freq
assert_inaccessible slider Playback Level
assert_absent plugin.control.2.14
screenshot loudness-manual
scroll_into_view rack.params plugin.choice.2.11.1
click plugin.choice.2.11.1
wait_idle
assert plugins.plugin.2.param.11.value == 1
assert_accessible slider Playback Level
assert_accessible slider Reference Level
assert_absent plugin.control.2.0
assert_inaccessible slider High Freq
assert_absent plugin.control.2.14
screenshot loudness-iso

# Auto uses an engine-owned volume readout, never an editable volume control.
scroll_into_view rack.params plugin.choice.2.11.2
click plugin.choice.2.11.2
wait_idle
assert plugins.plugin.2.param.11.value == 2
assert_visible plugin.control.2.14
assert_absent plugin.param.2.14.exact
assert_inaccessible slider Playback Volume
assert_inaccessible slider Playback Level
assert_accessible slider Reference Level

# Entering a reference level does not silently claim acoustic calibration.
plugin_param_set 2 17 0
scroll_into_view rack.params plugin.control.2.13
click plugin.control.2.13
wait_idle
scroll_into_view rack.params plugin.param.2.13.exact
click plugin.param.2.13.exact
key cmd-a
type "78"
key enter
wait_idle
assert plugins.plugin.2.param.13.value == 78 tolerance=0.001
assert plugins.plugin.2.param.17.value == 0
assert plugins.plugin.2.enabled == true
screenshot loudness-auto-uncalibrated

# Explicit calibration state and mode survive a preset round trip.
plugin_param_set 2 17 1

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/FletcherMunson.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/FletcherMunson.json
assert plugins.plugin.2.type == "Loudness Compensation"
assert plugins.plugin.2.param.11.value == 2
assert plugins.plugin.2.param.13.value == 78 tolerance=0.001
assert plugins.plugin.2.param.17.value == 1

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
