# Gate plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Gate
assert plugins.count > 0
assert plugins.plugin.2.type == "Gate"

# 15 parameter(s)
plugin_param_set 2 0 -56.0
plugin_param_set 2 1 30.7
plugin_param_set 2 2 15.069999999999999
plugin_param_set 2 3 300.0
plugin_param_set 2 4 607.0
plugin_param_set 2 5 0.3
plugin_param_set 2 6 1.0
plugin_param_set 2 7 60.0
plugin_param_set 2 8 1.0
plugin_param_set 2 9 1.0
plugin_param_set 2 10 1.0
plugin_param_set 2 11 36.0
plugin_param_set 2 12 3.5999999999999996
plugin_param_set 2 13 6.0
plugin_param_set 2 14 6.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Gate.json
plugin_remove 2
assert plugins.plugin.2.type != "Gate"
plugin_chain_load $SOTF_QA_DIR/Gate.json
assert plugins.plugin.2.type == "Gate"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Gate"
