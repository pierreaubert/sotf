# Downmix plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Downmix
assert plugins.count > 0
assert plugins.plugin.2.type == "Downmix"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Downmix
assert plugins.plugin.2.param_count == 9
scroll_into_view rack.params plugin.choice.2.7.0
click plugin.choice.2.7.0
assert plugins.plugin.2.param.7.value == 0
scroll_into_view rack.params plugin.choice.2.7.1
click plugin.choice.2.7.1
assert plugins.plugin.2.param.7.value == 1
scroll_into_view rack.params plugin.choice.2.8.0
click plugin.choice.2.8.0
assert plugins.plugin.2.param.8.value == 0
scroll_into_view rack.params plugin.choice.2.8.1
click plugin.choice.2.8.1
assert plugins.plugin.2.param.8.value == 1
screenshot downmix-primary-modes
assert plugins.plugin.2.param.0.value == -3 tolerance=0.001
assert plugins.plugin.2.param.1.value == -3 tolerance=0.001
assert playback.is_playing == false

# 9 parameters; primary mode choices are exercised above.
plugin_param_set 2 0 -8.4
plugin_param_set 2 1 -8.4
plugin_param_set 2 2 -42.0
plugin_param_set 2 3 -42.0
plugin_param_set 2 4 1.0
plugin_param_set 2 5 370.0
plugin_param_set 2 6 2200.0
plugin_param_set 2 7 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Downmix.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Downmix.json
assert plugins.plugin.2.type == "Downmix"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
