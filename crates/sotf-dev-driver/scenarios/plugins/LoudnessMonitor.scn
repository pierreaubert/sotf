# LoudnessMonitor plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add LoudnessMonitor
assert plugins.count > 0
assert plugins.plugin.2.type == "Loudness Monitor"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-LoudnessMonitor

# 0 parameter(s)

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/LoudnessMonitor.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/LoudnessMonitor.json
assert plugins.plugin.2.type == "Loudness Monitor"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
