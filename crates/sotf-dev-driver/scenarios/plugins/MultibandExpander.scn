# MultibandExpander plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add MultibandExpander
assert plugins.count > 0
assert plugins.plugin.2.type == "MultibandExpander"

# 18 parameter(s)
plugin_param_set 2 0 2.9
plugin_param_set 2 1 0.8999999999999999
plugin_param_set 2 2 164.0
plugin_param_set 2 3 1850.0
plugin_param_set 2 4 8000.0
plugin_param_set 2 5 12400.0
plugin_param_set 2 6 -56.0
plugin_param_set 2 7 6.7
plugin_param_set 2 8 15.069999999999999
plugin_param_set 2 9 607.0
plugin_param_set 2 10 24.0
plugin_param_set 2 11 6.0
plugin_param_set 2 12 3.5999999999999996
plugin_param_set 2 13 150.0
plugin_param_set 2 14 0.3
plugin_param_set 2 15 1.0
plugin_param_set 2 16 1.0
plugin_param_set 2 17 6.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/MultibandExpander.json
plugin_remove 2
assert plugins.plugin.2.type != "MultibandExpander"
plugin_chain_load $SOTF_QA_DIR/MultibandExpander.json
assert plugins.plugin.2.type == "MultibandExpander"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "MultibandExpander"
