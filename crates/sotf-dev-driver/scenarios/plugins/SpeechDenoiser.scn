# SpeechDenoiser plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add SpeechDenoiser
assert plugins.count > 0
assert plugins.plugin.2.type == "SpeechDenoiser"

# 1 parameter(s)
plugin_param_set 2 0 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/SpeechDenoiser.json
plugin_remove 2
assert plugins.plugin.2.type != "SpeechDenoiser"
plugin_chain_load $SOTF_QA_DIR/SpeechDenoiser.json
assert plugins.plugin.2.type == "SpeechDenoiser"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "SpeechDenoiser"
