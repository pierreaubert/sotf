# ABCompare plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add ABCompare
assert plugins.count > 0
assert plugins.plugin.2.type == "ABCompare"

# 14 parameter(s)
plugin_param_set 2 0 -0.4
plugin_param_set 2 1 1.0
plugin_param_set 2 2 1.0
plugin_param_set 2 3 1.0
plugin_param_set 2 4 1.0
plugin_param_set 2 5 1.0
plugin_param_set 2 6 7.199999999999999
plugin_param_set 2 7 150.7
plugin_param_set 2 8 150.7
# skipping file parameter 9: Path A Config
# skipping file parameter 10: Path B Config
plugin_param_set 2 11 1.0
plugin_param_set 2 12 1.0
plugin_param_set 2 13 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/ABCompare.json
plugin_remove 2
assert plugins.plugin.2.type != "ABCompare"
plugin_chain_load $SOTF_QA_DIR/ABCompare.json
assert plugins.plugin.2.type == "ABCompare"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "ABCompare"
