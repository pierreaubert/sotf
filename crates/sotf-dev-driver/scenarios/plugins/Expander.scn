# Expander plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Expander
assert plugins.count > 0
assert plugins.plugin.2.type == "Expander"

# 15 parameter(s)
plugin_param_set 2 0 -56.0
plugin_param_set 2 1 6.7
plugin_param_set 2 2 15.069999999999999
plugin_param_set 2 3 607.0
plugin_param_set 2 4 24.0
plugin_param_set 2 5 6.0
plugin_param_set 2 6 3.5999999999999996
plugin_param_set 2 7 150.0
plugin_param_set 2 8 0.3
plugin_param_set 2 9 1.0
plugin_param_set 2 10 1.0
plugin_param_set 2 11 150.0
plugin_param_set 2 12 6.0
plugin_param_set 2 13 1.0
plugin_param_set 2 14 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Expander.json
plugin_remove 2
assert plugins.plugin.2.type != "Expander"
plugin_chain_load $SOTF_QA_DIR/Expander.json
assert plugins.plugin.2.type == "Expander"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Expander"
