# Compressor plugin lifecycle scenario
# Editor rendering plus API parameter/preset lifecycle; not full control interaction parity.
focus Studio
assert screen.focused == "Studio"
plugin_clear
plugin_add Compressor
assert plugins.count > 0
assert plugins.plugin.2.type == "Compressor"
action PluginSelectFirstUser
wait_idle
assert_visible rack.plugin.2.toggle
assert_visible rack.params
screenshot editor-Compressor

click rack.config.toggle
wait_idle
assert_visible plugin.choice.2.8.1
scroll_into_view rack.config.scroll plugin.choice.2.8.0
click plugin.choice.2.8.0
assert plugins.plugin.2.param.8.value == 0
click plugin.choice.2.8.1
assert plugins.plugin.2.param.8.value == 1
wait_idle
assert_in_viewport plugin.choice.2.8.1
assert_absent plugin.choice.2.10.0
assert_absent plugin.choice.2.11.0
assert_absent plugin.choice.2.15.0
assert_inaccessible slider Sidechain HPF
screenshot editor-Compressor-setup
click rack.config.toggle
wait_idle

# 16 parameter(s)
plugin_param_set 2 0 -42.0
plugin_param_set 2 1 6.7
plugin_param_set 2 2 30.07
plugin_param_set 2 3 307.0
plugin_param_set 2 4 6.0
plugin_param_set 2 5 -9.600000000000001
plugin_param_set 2 6 0.3
plugin_param_set 2 7 1.0
plugin_param_set 2 8 1.0
plugin_param_set 2 9 60.0
plugin_param_set 2 10 1.0
plugin_param_set 2 11 1.0
plugin_param_set 2 12 6.0
plugin_param_set 2 13 1.0
plugin_param_set 2 14 1.0
plugin_param_set 2 15 1.0

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Compressor.json
plugin_remove 2
assert plugins.user_count == 0
plugin_chain_load $SOTF_QA_DIR/Compressor.json
assert plugins.plugin.2.type == "Compressor"

# Delete and verify cleanup
plugin_remove 2
assert plugins.user_count == 0
