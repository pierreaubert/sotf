# Matrix plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add Matrix
assert plugins.count > 0
assert plugins.plugin.2.type == "Matrix"

# 0 parameter(s)

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/Matrix.json
plugin_remove 2
assert plugins.plugin.2.type != "Matrix"
plugin_chain_load $SOTF_QA_DIR/Matrix.json
assert plugins.plugin.2.type == "Matrix"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "Matrix"
