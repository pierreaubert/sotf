# DynamicEq plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add DynamicEq
assert plugins.count > 0
assert plugins.plugin.2.type == "DynamicEq"

# 36 parameter(s)
plugin_param_set 2 0 3.1
plugin_param_set 2 1 -42.0
plugin_param_set 2 2 6.7
plugin_param_set 2 3 30.07
plugin_param_set 2 4 307.0
plugin_param_set 2 5 6.0
plugin_param_set 2 6 1.0
plugin_param_set 2 7 0.3
# stopping at parameter 8: query out of range

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/DynamicEq.json
plugin_remove 2
assert plugins.plugin.2.type != "DynamicEq"
plugin_chain_load $SOTF_QA_DIR/DynamicEq.json
assert plugins.plugin.2.type == "DynamicEq"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "DynamicEq"
