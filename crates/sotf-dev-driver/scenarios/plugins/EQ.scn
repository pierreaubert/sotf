# EQ plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add EQ
assert plugins.count > 0
assert plugins.plugin.2.type == "EQ"

# 20 parameter(s)
plugin_param_set 2 0 6.7
plugin_param_set 2 1 1.0
plugin_param_set 2 2 1.0
# stopping at parameter 3: query out of range

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/EQ.json
plugin_remove 2
assert plugins.plugin.2.type != "EQ"
plugin_chain_load $SOTF_QA_DIR/EQ.json
assert plugins.plugin.2.type == "EQ"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "EQ"
