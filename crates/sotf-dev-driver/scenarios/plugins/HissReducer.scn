# HissReducer plugin lifecycle scenario
focus plugins
plugin_clear
plugin_add HissReducer
assert plugins.count > 0
assert plugins.plugin.2.type == "HissReducer"

# 4 parameter(s)
plugin_param_set 2 0 1.0
plugin_param_set 2 1 -45.0
plugin_param_set 2 2 5500.0
plugin_param_set 2 3 0.3

# Save, remove, reload
plugin_chain_save $SOTF_QA_DIR/HissReducer.json
plugin_remove 2
assert plugins.plugin.2.type != "HissReducer"
plugin_chain_load $SOTF_QA_DIR/HissReducer.json
assert plugins.plugin.2.type == "HissReducer"

# Delete and verify cleanup
plugin_remove 2
assert plugins.plugin.2.type != "HissReducer"
