# Import the published fixture through the wizard and inspect its delivered result.
focus room-e-q
assert roomeq.step == "LoadData"
assert roomeq.measurement_count == 0
scroll_into_view roomeq.content roomeq.load_from_file
click roomeq.load_from_file
wait_until roomeq.measurement_count == 3 timeout=10s
click roomeq.next
wait_until roomeq.step == "Delay" timeout=5s
click roomeq.next
wait_until roomeq.step == "Process" timeout=5s
scroll_into_view roomeq.content roomeq.select_simple
click roomeq.select_simple
wait_until roomeq.step == "Configure" timeout=5s
click roomeq.next
wait_until roomeq.step == "Optimize" timeout=5s
scroll_into_view roomeq.content roomeq.optimize_target
click roomeq.optimize_target
click roomeq.optimize_target.1
scroll_into_view roomeq.content roomeq.optimize_start
click roomeq.optimize_start
wait_until roomeq.optimization_status != "Idle" timeout=10s
wait_until roomeq.optimization_status == "Completed" timeout=150s
assert roomeq.step == "Review"
assert roomeq.result_count == 3
click roomeq.next
wait_until roomeq.step == "Export" timeout=5s
scroll_into_view roomeq.content roomeq.export_file
assert_absent roomeq.export_unsupported_reason
assert_enabled roomeq.export_file == true
click roomeq.export_file
wait_until roomeq.export.saved_format == "CamillaDSP" timeout=10s
