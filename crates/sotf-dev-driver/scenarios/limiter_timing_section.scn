# German Light150 at 600x1000; timing header measured from native screenshot.
focus Studio
plugin_clear
plugin_add Limiter
action PluginSelectFirstUser
wait_idle
scroll_at 15 700 -700
wait_idle
click_at 300 785
wait_idle
scroll_into_view rack.params plugin.choice.2.6.1
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
scroll_into_view rack.params plugin.choice.2.6.0
click plugin.choice.2.6.0
assert plugins.plugin.2.param.6.value == 0
click plugin.choice.2.6.1
assert plugins.plugin.2.param.6.value == 1
scroll_into_view rack.params plugin.control.2.2
click plugin.control.2.2
wait_idle
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "5"
key enter
wait_idle
assert plugins.plugin.2.param.2.value == 5 tolerance=0.001
screenshot limiter-timing-edited
plugin_chain_save $SOTF_QA_DIR/limiter-timing.json
plugin_remove 2
plugin_chain_load $SOTF_QA_DIR/limiter-timing.json
assert plugins.plugin.2.param.2.value == 5 tolerance=0.001
assert plugins.plugin.2.param.6.value == 1
assert playback.is_playing == false
