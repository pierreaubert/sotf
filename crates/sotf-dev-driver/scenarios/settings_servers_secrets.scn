# Rendered remote-server configuration: credentials are masked by default and
# only non-secret semantic state is exposed to QA.
focus settings
assert screen.focused == "Settings"
action SettingsSetTab {"tab":"Servers"}
wait_idle 2s
assert settings.active_tab == "Servers"

# MPD defaults to certificate authentication. Switch through the visible
# control, then prove the password is masked in both paint and accessibility.
scroll preferences.content -450
sleep 200ms
assert_visible settings.servers.mpd-auth-password
click settings.servers.mpd-auth-password
sleep 100ms
assert_visible settings.servers.mpd-password
assert_visible settings.servers.mpd-password.reveal
click settings.servers.mpd-password
type_secret "qa-mpd-password-do-not-log"
assert settings.mpd_password_configured == true
assert settings.mpd_password_revealed == false
assert_accessible_masked textbox Password
assert_accessible button Show Password
screenshot settings-servers-mpd-password-masked
click settings.servers.mpd-password.reveal
assert settings.mpd_password_revealed == true
assert_accessible button Hide Password
click settings.servers.mpd-password.reveal
assert settings.mpd_password_revealed == false
assert_accessible_masked textbox Password
click settings.servers.mpd-password
key cmd-a
key backspace
assert settings.mpd_password_configured == false

# Return to the top before moving to the remote-player section so scroll
# offsets remain deterministic across font and platform metrics.
scroll preferences.content 450
scroll preferences.content -1200
wait_idle 1s
assert_visible settings.servers.remote-sotf-name
assert_visible settings.servers.remote-sotf-url
assert_visible settings.servers.remote-sotf-token
assert_visible settings.servers.remote-sotf-token.reveal
assert_accessible textbox API Token
assert_accessible button Show API Token
click settings.servers.remote-sotf-name
type "QA Remote"
click settings.servers.remote-sotf-url
type "http://127.0.0.1:9"
click settings.servers.remote-sotf-token
type_secret "qa-token-do-not-log"
assert settings.remote_manual_token_configured == true
assert settings.remote_token_revealed == false
assert_accessible_masked textbox API Token
screenshot settings-servers-api-token-masked
click settings.servers.remote-sotf-token.reveal
assert settings.remote_token_revealed == true
assert_accessible button Hide API Token
click settings.servers.remote-sotf-token.reveal
assert settings.remote_token_revealed == false
assert_accessible_masked textbox API Token
click settings.servers.remote.add
wait_until settings.remote_server_count == 1 timeout=3s
