# Plugin graph (Studio Full) screen.
#
# Reproducible run:
#   QA_DIR=$(mktemp -d)
#   cargo run -p sotf-gpui --features dev-api --bin SotF -- --qa "$QA_DIR" &
#   cargo run -p sotf-dev-driver -- crates/sotf-dev-driver/scenarios/plugin_graph.scn -v

focus       plugin-graph
assert      screen.focused == "PluginGraph"

focus       library
assert      screen.focused == "Library"
