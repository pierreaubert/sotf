# Exercise format selection and preserve the previous receipt on write failure.
action SpinoramaSetExportFixture
resize 600 1000
wait_idle 500ms
scroll_into_view spinorama.content spinorama.export_save
click spinorama.export_save
wait_until spinorama.export_current == true timeout=5s
assert spinorama.export_filter_summary == "Lowshelf@96000,Highshelf@96000,Notch@96000"
qa_empty_dir create spinorama_eq_Export_Fixture.txt
scroll_into_view spinorama.content spinorama.export_format.apo
click spinorama.export_format.apo
scroll_into_view spinorama.content spinorama.export_save
click spinorama.export_save
wait_idle 1s
scroll_into_view spinorama.content spinorama.export_error
assert_in_viewport spinorama.export_error
assert spinorama.export_current == true
assert spinorama.export_filter_summary == "Lowshelf@96000,Highshelf@96000,Notch@96000"
qa_empty_dir remove spinorama_eq_Export_Fixture.txt
scroll_into_view spinorama.content spinorama.export_save
click spinorama.export_save
wait_idle 1s
assert_absent spinorama.export_error
scroll_into_view spinorama.content spinorama.export_format.camilladsp
click spinorama.export_format.camilladsp
scroll_into_view spinorama.content spinorama.export_save
click spinorama.export_save
wait_idle 1s
assert_absent spinorama.export_error
scroll_into_view spinorama.content correction.export_status
screenshot spinorama-export-formats
assert playback.is_playing == false
