resize 600 1000
# A real write collision must leave export status unchanged and allow retry.
action HeadphoneSetFileFixture {"mode":"valid"}
wait_until headphone.loading == false timeout=5s
assert headphone.export_current == false
click headphone.next
wait_until headphone.step == "Optimization" timeout=2s
scroll headphone.content -5000
wait_idle 500ms
click headphone.optimize_start
wait_until headphone.optimization_status != "Running" timeout=25s
assert headphone.optimization_status == "Completed"
assert headphone.result_revision == 1
click headphone.next
wait_until headphone.step == "Listen" timeout=2s
click headphone.next
wait_until headphone.step == "Export" timeout=2s
assert headphone.export_current == false
qa_empty_dir create headphone-exports
qa_empty_dir create headphone-exports/headphone_eq.json
scroll_into_view headphone.content headphone.export
click headphone.export
assert toast.type == "Error"
assert headphone.export_current == false
assert headphone.export_exists == false
screenshot headphone-export-write-failure
qa_empty_dir remove headphone-exports/headphone_eq.json
click headphone.export
wait_until headphone.export_current == true timeout=3s
assert headphone.export_exists == true
assert headphone.export_revision == 1
assert headphone.export_json_reloadable == true
scroll_into_view headphone.content correction.export_status
wait_idle 500ms
screenshot headphone-export-recovered
