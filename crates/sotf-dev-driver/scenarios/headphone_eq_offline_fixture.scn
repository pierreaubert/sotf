# Hermetic Headphone EQ discovery. The test drives the same visible refresh
# and selection controls used in production; the dev API only supplies the
# network responses.
assert screen.focused == "HeadphoneEq"
wait_idle 2s
assert_visible headphone.refresh
assert_accessible button Refresh
click headphone.refresh
wait_until headphone.loading == false timeout=5s
assert headphone.catalog_count == 2
assert headphone.suggestion_count == 2
assert_visible headphone.select.Fixture One
assert_visible headphone.select.Fixture Two
screenshot headphone-discovery-catalog
click headphone.select.Fixture One
wait_until headphone.loading == false timeout=5s
assert headphone.selected == "Fixture One"
assert headphone.curve_point_count == 3
screenshot headphone-discovery-selected
assert headphone.step == "MeasurementTarget"
assert_visible headphone.next
assert_accessible button Continue
click headphone.next
wait_until headphone.step == "Optimization" timeout=2s
assert_visible headphone.optimize_start
screenshot headphone-configure
# Stage navigation is independent of detail level and never starts optimization.
assert headphone.autoeq_stage == "Goals"
click autoeq.stage.1
assert headphone.autoeq_stage == "FilterDesign"
click autoeq.detail
assert headphone.autoeq_detail == "Intermediate"
click autoeq.detail
assert headphone.autoeq_detail == "Expert"
assert_visible autoeq.filter-count
screenshot headphone-autoeq-filter-design
click autoeq.stage.2
assert headphone.autoeq_stage == "Timing"
screenshot headphone-autoeq-timing-unavailable
click autoeq.stage.3
assert headphone.autoeq_stage == "Algorithm"
screenshot headphone-autoeq-algorithm
click autoeq.stage.4
assert headphone.autoeq_stage == "Review"
screenshot headphone-autoeq-review
click autoeq.stage.0
assert headphone.autoeq_stage == "Goals"
click autoeq.detail
assert headphone.autoeq_detail == "Simple"
click headphone.optimize_start
wait_until headphone.optimization_status != "Running" timeout=20s
assert headphone.optimization_status == "Completed"
assert_visible headphone.next
click headphone.next
wait_until headphone.step == "Listen" timeout=2s
screenshot headphone-listen
assert_visible headphone.audition.original
assert_visible headphone.audition.corrected
click headphone.audition.corrected
wait_until headphone.audition_pending == false timeout=2s
assert headphone.audition_active == true
assert headphone.audition_corrected == true
assert_visible headphone.audition.preamp
screenshot headphone-listen-corrected
click headphone.audition.original
wait_until headphone.audition_pending == false timeout=2s
assert headphone.audition_corrected == false
click headphone.audition.stop
wait_until headphone.audition_active == false timeout=2s
click headphone.audition.corrected
wait_until headphone.audition_pending == false timeout=2s
click headphone.next
wait_until headphone.step == "Export" timeout=2s
wait_until headphone.audition_active == false timeout=2s
screenshot headphone-export
wait_idle 250ms
scroll_into_view headphone.content headphone.apply
assert_visible headphone.apply
click headphone.apply
wait_until headphone.easy_applied == true timeout=2s
assert headphone.easy_applied == true
wait_idle 250ms
screenshot headphone-export-applied
scroll_into_view headphone.content headphone.export
assert_visible headphone.export
click headphone.export
wait_until headphone.export_exists == true timeout=2s
assert headphone.export_exists == true
assert headphone.export_json_reloadable == true
