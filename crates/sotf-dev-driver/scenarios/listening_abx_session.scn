# ABX session: prepare from real local media, exercise concealed cues and two
# committed trials, save through the visible control, clear, and visibly reload.
focus       library
wait_until  library.album_count > 0 timeout=10s
wait_idle   2s
action      AddToQueue
wait_until  queue.length > 0 timeout=3s
action      PlayPause
wait_until  playback.is_playing == true timeout=3s
action      ListeningResetGuide
click       listening.guide.acknowledge
click       sidebar.nav-ab-compare
wait_until  listening.surface == "BlindComparison" timeout=2s
click       listening.capture.a
click       listening.capture.b
wait_until  listening.paths_ready == true timeout=2s
click       listening.session.prepare
wait_until  listening.session_ready == true timeout=20s
key         ctrl-x
wait_until  listening.pending_mode == "Abx" timeout=2s
key         alt-1
key         alt-2
key         alt-3
key         alt-a
wait_until  listening.completed_trials == 1 timeout=2s
key         ctrl-x
wait_until  listening.pending_mode == "Abx" timeout=2s
key         alt-3
key         alt-b
wait_until  listening.completed_trials == 2 timeout=2s
assert      listening.abx_total == 2
assert      listening.pending_mode == null
assert_visible listening.session.listening-save-session
click       listening.session.listening-save-session
wait_until  listening.session_file_exists == true timeout=2s
action      ListeningClearSession
assert      listening.session_exists == false
assert      listening.completed_trials == 0
assert_visible listening.session.listening-load-session
click       listening.session.listening-load-session
wait_until  listening.completed_trials == 2 timeout=2s
assert      listening.session_ready == true
assert      listening.runtime_active == false
accessibility
screenshot  listening-abx-reloaded
