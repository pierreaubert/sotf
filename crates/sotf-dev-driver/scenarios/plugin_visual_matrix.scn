# ── Representative color-vision palette + reduced motion ───────────────────
action CycleTheme
action CycleTheme
assert settings.theme == "Protanopia"
focus settings
click settings.tab.Theme
scroll settings.content -1400
wait_idle 500ms
assert_in_viewport settings.appearance.reduce-motion
click settings.appearance.reduce-motion
assert settings.reduce_motion == true timeout=2s
click preferences.done
assert screen.focused == "Studio"
