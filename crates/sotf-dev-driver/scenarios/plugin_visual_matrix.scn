# ── Regular / midnight / French / 150% ─────────────────────────────────────
action CycleTheme
assert settings.theme == "Midnight"
action CycleLanguage
assert settings.language == "French"
resize 1024 768
focus settings
click settings.tab.Theme
assert_in_viewport settings.appearance.font-scale
click settings.appearance.font-scale
key cmd-a
type "150"
key enter
assert settings.font_scale == 1.5 tolerance=0.01
click preferences.done
assert screen.focused == "Studio"
assert_in_viewport studio.workspace-picker
click studio.workspace-picker
key down
key enter
assert screen.focused == "PluginGraph"
click studio.workspace-picker
key up
key enter
assert screen.focused == "Studio"

