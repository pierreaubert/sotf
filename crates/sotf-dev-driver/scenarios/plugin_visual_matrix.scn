# Plugin visual matrix — 2026-08-26
#
# Opens every PluginType exposed by the generated per-plugin lifecycle inventory.
# The custom/fallback classification mirrors GpuiViewRegistry: 16 custom renderers;
# every remaining built-in uses the shared declarative PluginLayout fallback.
#
# Cross-cutting coverage is pairwise rather than a full Cartesian product:
#   compact  700x600   light          English 100%
#   regular  1024x768  midnight       French  150%
#   wide     1600x1000 high contrast  Spanish 200%
# plus German long-label and Protanopia/reduced-motion spot checks.
#
# Every capture requires a visible in-viewport editor/rack control, separated rack
# and detail panes, and an accessibility tree with zero unnamed focusables.

action PluginClear
action ResetFontSize
assert settings.font_scale == 1.0 tolerance=0.01
assert settings.theme == "Dark"
assert settings.language == "English"
action CycleTheme
assert settings.theme == "Light"
resize 700 600
focus Studio
assert_in_viewport studio.workspace-picker
assert screen.focused == "Studio"

# ── Compact / light / English / 100% ────────────────────────────────────────
# custom: ABCompare
plugin_clear
plugin_add ABCompare
action PluginSelectFirstUser
wait_until plugins.user_count == 1 timeout=3s
wait_idle 500ms
assert_visible rack.params
assert_in_viewport rack.params
assert_visible rack.add.open
assert_in_viewport rack.add.open
assert_non_overlapping studio.workspace-picker rack.params
accessibility
screenshot plugin-compact-light-en-100-custom-abcompare
