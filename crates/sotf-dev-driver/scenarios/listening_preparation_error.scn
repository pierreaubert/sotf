action ListeningResetGuide
click listening.guide.acknowledge
wait_until listening.guide_open == false timeout=3s
click listening.tab-comparison
wait_until listening.surface == "BlindComparison" timeout=3s
action ListeningSetSourceFixture {"mode":"comparison-silent"}
wait_until playback.current_filename == "comparison-source-silent.wav" timeout=10s
assert playback.is_playing == false
click listening.capture.a
click listening.capture.b
wait_until listening.paths_ready == true timeout=3s
resize 600 1000
wait_idle 500ms
scroll_into_view listening.comparison.content listening.session.prepare
click listening.session.prepare
wait_until listening.status == "audio is too quiet to level match reliably" timeout=20s
assert listening.session_ready == false
scroll listening.comparison.content -10000
wait_idle 500ms
screenshot listening-preparation-quiet-error
action ListeningSetSourceFixture {"mode":"comparison"}
wait_until playback.current_filename == "comparison-source-stereo.wav" timeout=10s
scroll_into_view listening.comparison.content listening.session.prepare
click listening.session.prepare
wait_until listening.session_ready == true timeout=20s
assert playback.is_playing == false
