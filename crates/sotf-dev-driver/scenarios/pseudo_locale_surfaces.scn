# QA-only pseudo locale at a compact logical width. The four screenshots
# exercise the player shell, Studio, Settings, and Room EQ with expanded copy.
wait_idle 1s
assert window.width == 900 tolerance=1
assert window.height == 720 tolerance=1
assert settings.theme == "Light"
assert settings.language == "Pseudo"
assert settings.font_scale == 1.5 tolerance=0.01
assert settings.reduce_motion == true

focus library
wait_until library.album_count > 0 timeout=10s
assert_visible library.tab.album
assert_in_viewport library.tab.album
screenshot pseudo-locale-player-compact-150
assert_perceptual_snapshot pseudo-locale-player-compact-150 crates/sotf-dev-driver/baselines/gpui/player-light-pseudo-900x720-150.png ssim=0.002 changed=0.0005

click sidebar.nav-studio-rack
wait_until screen.focused == "Studio" timeout=2s
wait_idle 1s
assert_visible rack.add.open
assert_in_viewport rack.add.open
screenshot pseudo-locale-studio-compact-150

focus settings
wait_until screen.focused == "Settings" timeout=2s
click settings.tab.Metadata
assert settings.active_tab == "Metadata"
assert_in_viewport settings.metadata.search-toggle
screenshot pseudo-locale-settings-compact-150

focus room-e-q
wait_until screen.focused == "RoomEq" timeout=2s
assert roomeq.step == "LoadData"
assert_visible roomeq.next
assert_in_viewport roomeq.next
screenshot pseudo-locale-roomeq-compact-150
assert_accessible button Çŀöšé
