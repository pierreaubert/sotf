# German Light150 600x1000; disclosure pointer measured from native screenshot.
focus Studio
plugin_clear
plugin_add Limiter
action PluginSelectFirstUser
wait_idle
scroll_at 15 700 -700
wait_idle
screenshot limiter-sections
click_at 300 844
wait_idle

scroll_into_view rack.params plugin.choice.2.3.1
assert_in_viewport plugin.choice.2.3.1
click plugin.choice.2.3.1
assert plugins.plugin.2.param.3.value == 1
wait_idle
scroll_into_view rack.params plugin.choice.2.3.0
assert_in_viewport plugin.choice.2.3.0
click plugin.choice.2.3.0
assert plugins.plugin.2.param.3.value == 0
wait_idle
scroll_into_view rack.params plugin.choice.2.5.1
assert_in_viewport plugin.choice.2.5.1
click plugin.choice.2.5.1
assert plugins.plugin.2.param.5.value == 1
wait_idle
scroll_into_view rack.params plugin.choice.2.5.0
assert_in_viewport plugin.choice.2.5.0
click plugin.choice.2.5.0
assert plugins.plugin.2.param.5.value == 0
wait_idle
scroll_into_view rack.params plugin.choice.2.9.1
assert_in_viewport plugin.choice.2.9.1
click plugin.choice.2.9.1
assert plugins.plugin.2.param.9.value == 1
wait_idle
scroll_into_view rack.params plugin.choice.2.9.0
assert_in_viewport plugin.choice.2.9.0
click plugin.choice.2.9.0
assert plugins.plugin.2.param.9.value == 0
wait_idle
screenshot limiter-detection-open
scroll_into_view rack.params plugin.control.2.8
click plugin.control.2.8
wait_idle
scroll_into_view rack.params plugin.param.2.8.exact
click plugin.param.2.8.exact
key cmd-a
type "50"
key enter
wait_idle
assert plugins.plugin.2.param.8.value == 0.5 tolerance=0.001
plugin_chain_save $SOTF_QA_DIR/limiter-detection.json
plugin_remove 2
plugin_chain_load $SOTF_QA_DIR/limiter-detection.json
assert plugins.plugin.2.param.8.value == 0.5 tolerance=0.001
assert plugins.plugin.2.param.3.value == 0
assert plugins.plugin.2.param.5.value == 0
assert plugins.plugin.2.param.9.value == 0
assert playback.is_playing == false
