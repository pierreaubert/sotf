# Gain uses the compact utility row. Measure its rendered bounds at two
# viewport widths so an empty right-side column cannot recur.
plugin_clear
focus Studio
plugin_add Gain
action PluginSelectFirstUser
wait_idle

resize 700 700
wait_idle
assert_visible plugin.layout.utility.row.2.0
assert_in_viewport plugin.layout.utility.row.2.0
assert_h_centered plugin.layout.utility.row.2.0 rack.params 16
assert_non_overlapping studio.workspace-picker rack.params
elements
screenshot plugin-layout-gain-700

resize 1440 900
wait_idle
assert_visible plugin.layout.utility.row.2.0
assert_in_viewport plugin.layout.utility.row.2.0
assert_h_centered plugin.layout.utility.row.2.0 rack.params 16
elements
screenshot plugin-layout-gain-1440

# Limiter exercises multiple generated groups and narrow wrapping.
plugin_clear
plugin_add Limiter
action PluginSelectFirstUser
resize 700 700
wait_idle
assert_visible plugin.layout.group.2.DYNAMICS
scroll_into_view rack.params plugin.control.2.1
assert_in_viewport plugin.control.2.1
assert_non_overlapping plugin.control.2.0 plugin.control.2.1
scroll_into_view rack.params plugin.control.2.7
assert_in_viewport plugin.control.2.7
scroll_into_view rack.params plugin.layout.header.2.TIMING
assert_in_viewport plugin.layout.header.2.TIMING
click plugin.layout.header.2.TIMING
wait_visible plugin.control.2.2 timeout=10s
scroll_into_view rack.params plugin.control.2.2
assert_in_viewport plugin.control.2.2
scroll_into_view rack.params plugin.control.2.6
assert_in_viewport plugin.control.2.6
scroll_into_view rack.params plugin.layout.header.2.DETECTOR
assert_in_viewport plugin.layout.header.2.DETECTOR
click plugin.layout.header.2.DETECTOR
wait_visible plugin.control.2.3 timeout=10s
scroll_into_view rack.params plugin.control.2.3
assert_in_viewport plugin.control.2.3
scroll_into_view rack.params plugin.control.2.5
assert_in_viewport plugin.control.2.5
scroll_into_view rack.params plugin.control.2.9
assert_in_viewport plugin.control.2.9
scroll_into_view rack.params plugin.control.2.8
assert_in_viewport plugin.control.2.8
scroll_into_view rack.params plugin.control.2.10
assert_in_viewport plugin.control.2.10
elements
screenshot plugin-layout-limiter-700

resize 2000 1000
wait_idle
assert_visible plugin.layout.group.2.DYNAMICS
assert_visible plugin.layout.group.2.TIMING
scroll_into_view rack.params plugin.layout.group.2.DYNAMICS
assert_in_viewport plugin.layout.group.2.DYNAMICS
scroll_into_view rack.params plugin.layout.group.2.TIMING
assert_in_viewport plugin.layout.group.2.TIMING
assert_non_overlapping plugin.layout.group.2.DYNAMICS plugin.layout.group.2.TIMING
elements
screenshot plugin-layout-limiter-2000
