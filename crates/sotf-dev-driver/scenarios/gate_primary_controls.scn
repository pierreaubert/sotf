# Gate primary reference controls through native exact entry.
resize 1000 900
focus Studio
wait_idle 500ms
plugin_clear
plugin_add Gate
action PluginSelectFirstUser
wait_until plugins.user_count == 1 timeout=3s
wait_idle 1s
assert_in_viewport rack.params
accessibility
screenshot gate-reference

scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "-35"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == -35 tolerance=0.001

scroll_into_view rack.params plugin.control.2.11
click plugin.control.2.11
wait_idle 500ms

scroll_into_view rack.params plugin.param.2.11.exact
click plugin.param.2.11.exact
key cmd-a
type "60"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.11.value == 60 tolerance=0.001

scroll_into_view rack.params plugin.control.2.2
click plugin.control.2.2
wait_idle 500ms

scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "5"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.2.value == 5 tolerance=0.001

scroll_into_view rack.params plugin.control.2.3
click plugin.control.2.3
wait_idle 500ms

scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "25"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.3.value == 25 tolerance=0.001

scroll_into_view rack.params plugin.control.2.4
click plugin.control.2.4
wait_idle 500ms

scroll_into_view rack.params plugin.param.2.4.exact
click plugin.param.2.4.exact
key cmd-a
type "250"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.4.value == 250 tolerance=0.001

scroll_into_view rack.params plugin.control.2.5
click plugin.control.2.5
wait_idle 500ms

scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "75"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.5.value == 0.75 tolerance=0.001
assert plugins.plugin.2.param.0.value == -35 tolerance=0.001
assert plugins.plugin.2.param.11.value == 60 tolerance=0.001
assert plugins.plugin.2.param.2.value == 5 tolerance=0.001
assert plugins.plugin.2.param.3.value == 25 tolerance=0.001
assert plugins.plugin.2.param.4.value == 250 tolerance=0.001
assert plugins.plugin.2.param.5.value == 0.75 tolerance=0.001
screenshot gate-primary-edited

resize 600 1000
wait_idle 1s

scroll_into_view rack.params plugin.control.2.0
click plugin.control.2.0
wait_idle 500ms
