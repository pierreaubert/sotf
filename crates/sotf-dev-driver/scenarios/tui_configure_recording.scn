# TUI Configure → Recording wizard navigation.
#
# Covers: Recording sub-screen, step tab navigation, Esc chains.

focus configure
assert screen.focused == "Configure"
assert input_mode == "Configure"

# Enter Recording sub-screen.
key 2
sleep 100ms
assert input_mode == "ConfigureRecording"
assert configure.sub_screen == "Recording"
assert recording.step == "Config"

# Navigate step tab bar forward with Right.
key right
sleep 100ms
assert recording.step == "SplCalibration"

key right
sleep 100ms
assert recording.step == "Capture"

# Navigate step tab bar backward with Left.
key left
sleep 100ms
assert recording.step == "SplCalibration"

# Esc from content → step tab bar (first level).
key esc
sleep 100ms
# Step tab should be focused; input_mode stays configure sub-screen.
assert input_mode == "ConfigureRecording"

# Esc again → Configure tab bar.
key esc
sleep 100ms
assert input_mode == "Configure"
assert screen.focused == "Configure"

# Return to library.
focus library
assert screen.focused == "Library"
