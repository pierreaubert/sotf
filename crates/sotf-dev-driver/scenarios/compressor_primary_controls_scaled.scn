focus Studio
plugin_clear
plugin_add Compressor
action PluginSelectFirstUser
wait_idle 1s
resize 1000 1000
wait_idle 1s
scroll_into_view rack.params plugin.control.2.0
click plugin.control.2.0
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.0.exact
click plugin.param.2.0.exact
key cmd-a
type "-30"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.0.value == -30 tolerance=0.001
scroll_into_view rack.params plugin.control.2.1
click plugin.control.2.1
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.1.exact
click plugin.param.2.1.exact
key cmd-a
type "3"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
scroll_into_view rack.params plugin.control.2.2
click plugin.control.2.2
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.2.exact
click plugin.param.2.2.exact
key cmd-a
type "8"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.2.value == 8 tolerance=0.001
scroll_into_view rack.params plugin.control.2.3
click plugin.control.2.3
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.3.exact
click plugin.param.2.3.exact
key cmd-a
type "150"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.3.value == 150 tolerance=0.001
scroll_into_view rack.params plugin.control.2.5
click plugin.control.2.5
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "4"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.5.value == 4 tolerance=0.001
scroll_into_view rack.params plugin.control.2.6
click plugin.control.2.6
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "75"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.6.value == 0.75 tolerance=0.001
assert plugins.plugin.2.param.0.value == -30 tolerance=0.001
assert plugins.plugin.2.param.1.value == 3 tolerance=0.001
assert plugins.plugin.2.param.2.value == 8 tolerance=0.001
assert plugins.plugin.2.param.3.value == 150 tolerance=0.001
assert plugins.plugin.2.param.5.value == 4 tolerance=0.001
assert plugins.plugin.2.param.6.value == 0.75 tolerance=0.001
screenshot compressor-primary-1000
resize 600 1000
wait_idle 1s
scroll_into_view rack.params plugin.param.2.0.exact
