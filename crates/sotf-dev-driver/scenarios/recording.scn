# Recording screen.
#
# Reproducible run:
#   QA_DIR=$(mktemp -d)
#   cargo run -p sotf-gpui --features dev-api --bin SotF -- --qa "$QA_DIR" &
#   cargo run -p sotf-dev-driver -- crates/sotf-dev-driver/scenarios/recording.scn -v

focus       recording
assert      screen.focused == "Recording"

focus       library
assert      screen.focused == "Library"
