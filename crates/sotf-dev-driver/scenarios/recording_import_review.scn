# Import through the production completion callback; no hardware capture.
focus recording
wait_until recording.channel_count == 4 timeout=10s
assert recording.step == "Evaluating"
assert recording.done_count == 4
assert_enabled recording.next == false
scroll_into_view recording.content recording.retake.0
screenshot imported-initial-review
assert_enabled recording.retake.0 == false
scroll_into_view recording.content recording.route.0.output
click recording.route.0.output
key down
key enter
screenshot imported-output-selected
scroll_into_view recording.content recording.retake.0
assert_enabled recording.retake.0 == false
scroll_into_view recording.content recording.route.0.input
click recording.route.0.input
key down
key enter
scroll_into_view recording.content recording.retake.0
screenshot imported-input-selected
assert_enabled recording.retake.0 == true
screenshot imported-routing-ready
scroll_into_view recording.content recording.accept.0
click recording.accept.0
assert_enabled recording.next == false
scroll_into_view recording.content recording.accept.1
click recording.accept.1
assert_enabled recording.next == false
scroll_into_view recording.content recording.accept.2
click recording.accept.2
assert_enabled recording.next == false
scroll_into_view recording.content recording.accept.3
click recording.accept.3
assert_enabled recording.next == true
screenshot imported-takes-accepted
scroll recording.content -10000
screenshot imported-review-bottom
scroll recording.content 450
screenshot imported-review-timing
click recording.next
assert recording.step == "Saving"
scroll_into_view recording.content recording.save
screenshot imported-save-ready
assert_enabled recording.save == true
click recording.save
wait_until recording.save_status == "Current" timeout=5s
screenshot imported-copy-saved
scroll_into_view recording.content recording.save_name
click recording.save_name
key cmd-a
type "Imported renamed copy"
assert recording.save_status == "Previous"
screenshot imported-copy-name
scroll_into_view recording.content recording.save
assert_enabled recording.save == true
click recording.save
wait_until recording.save_status == "Current" timeout=5s
assert recording.done_count == 4
screenshot imported-copy-renamed
# A failed copy must preserve accepted imported driver/seat measurements.
scroll_into_view recording.content recording.save_name
click recording.save_name
key cmd-a
type "Imported collision"
assert recording.save_status == "Previous"
qa_empty_dir create recordings/Imported_collision
scroll_into_view recording.content recording.save
click recording.save
assert recording.status_severity == "Error"
assert recording.save_status == "Previous"
assert recording.done_count == 4
screenshot imported-copy-save-failed
qa_empty_dir remove recordings/Imported_collision
click recording.save
wait_until recording.save_status == "Current" timeout=5s
assert recording.status_severity == "Success"
assert recording.done_count == 4
screenshot imported-copy-save-recovered
assert playback.is_playing == false
