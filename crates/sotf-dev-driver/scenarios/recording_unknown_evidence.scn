# Missing quality evidence remains visible for review while the real waveform
# and saved capture artifacts are preserved.
focus       recording
assert      recording.step == "Capture"
assert_visible recording.capture_all
click       recording.capture_all
wait_until recording.review_count == 1 timeout=30s
assert      recording.review_count == 1
assert      recording.quality_count == 1
assert      recording.take.0.state == "ReviewNeeded"
assert      recording.take.0.quality_present == true
assert      recording.take.0.evidence_complete == true
assert      recording.take.0.snr_status == "Unknown"
assert      recording.take.0.quality_trustworthy == false
assert      recording.status_severity == "Warning"
screenshot  recording-unknown-evidence-review
click       recording.accept_take_0
wait_until  recording.review_count == 1 timeout=30s
assert      recording.take.1.quality_present == true
scroll      recording.content -600
click       recording.accept_take_1
wait_until  recording.done_count == 2 timeout=30s
assert      recording.done_count == 2
