# 2026-09-09: History in listening_test.rs silently displayed only eight sessions.
# The history renderer now exposes all records and retained difficulty details.
# Run: target/debug/sotf-dev-driver run-suite crates/sotf-dev-driver/suites/listening_history_ui.toml
# Screenshots require visual review of the saved settings and localized labels.
action ListeningResetGuide
click listening.guide.acknowledge
wait_until listening.guide_open == false timeout=3s
scroll_into_view listening.eq.content listening.eq.config.trials
click listening.eq.config.trials
key cmd-a
type "1"
key enter
assert listening.eq.config.trials == 1
scroll_into_view listening.eq.content listening.eq.start
click listening.eq.start
wait_until listening.eq.has_question == true timeout=3s
click listening.eq.answer.0
click listening.eq.submit
wait_until listening.eq.answered == true timeout=3s
click listening.eq.next
wait_until listening.eq.progress_sessions == 1 timeout=3s
