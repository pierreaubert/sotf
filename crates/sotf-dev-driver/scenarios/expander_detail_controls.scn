# Timing header coordinates are grounded in the explicit 1600x1200 viewport.
# Open before exact-entry selection changes the content height.
resize 1600 1200
focus Studio
plugin_clear
plugin_add Expander
action PluginSelectFirstUser
wait_idle 1s
scroll_at 200 700 -3000
wait_idle 500ms
screenshot expander-disclosures
click_at 800 783
wait_idle 500ms
scroll_into_view rack.params plugin.control.2.5
click plugin.control.2.5
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "8"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.5.value == 8 tolerance=0.001
scroll_into_view rack.params plugin.control.2.6
click plugin.control.2.6
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "6"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.6.value == 6 tolerance=0.001
scroll_into_view rack.params plugin.control.2.7
click plugin.control.2.7
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "25"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.7.value == 25 tolerance=0.001
scroll_into_view rack.params plugin.control.2.12
click plugin.control.2.12
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.12.exact
click plugin.param.2.12.exact
key cmd-a
type "3"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.12.value == 3 tolerance=0.001
assert plugins.plugin.2.param.5.value == 8 tolerance=0.001
assert plugins.plugin.2.param.6.value == 6 tolerance=0.001
assert plugins.plugin.2.param.7.value == 25 tolerance=0.001
assert plugins.plugin.2.param.12.value == 3 tolerance=0.001
screenshot expander-details-edited
plugin_chain_save $SOTF_QA_DIR/expander-details.json
plugin_remove 2
plugin_chain_load $SOTF_QA_DIR/expander-details.json
assert plugins.plugin.2.param.5.value == 8 tolerance=0.001
assert plugins.plugin.2.param.6.value == 6 tolerance=0.001
assert plugins.plugin.2.param.7.value == 25 tolerance=0.001
assert plugins.plugin.2.param.12.value == 3 tolerance=0.001

resize 600 1000
wait_idle 1s
scroll_at 25 650 -3000
wait_idle 500ms
screenshot expander-details-narrow

scroll_into_view rack.params plugin.control.2.5
wait_idle 500ms
screenshot expander-narrow-knee
scroll_into_view rack.params plugin.control.2.5
click plugin.control.2.5
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.5.exact
click plugin.param.2.5.exact
key cmd-a
type "10"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.5.value == 10 tolerance=0.001
scroll_into_view rack.params plugin.control.2.6
click plugin.control.2.6
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.6.exact
click plugin.param.2.6.exact
key cmd-a
type "7"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.6.value == 7 tolerance=0.001
scroll_into_view rack.params plugin.control.2.7
click plugin.control.2.7
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.7.exact
click plugin.param.2.7.exact
key cmd-a
type "30"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.7.value == 30 tolerance=0.001
scroll_into_view rack.params plugin.control.2.12
click plugin.control.2.12
wait_idle 500ms
scroll_into_view rack.params plugin.param.2.12.exact
click plugin.param.2.12.exact
key cmd-a
type "4"
key enter
wait_idle 500ms
assert plugins.plugin.2.param.12.value == 4 tolerance=0.001
assert plugins.plugin.2.param.5.value == 10 tolerance=0.001
assert plugins.plugin.2.param.6.value == 7 tolerance=0.001
assert plugins.plugin.2.param.7.value == 30 tolerance=0.001
assert plugins.plugin.2.param.12.value == 4 tolerance=0.001
screenshot expander-narrow-timing-edited
