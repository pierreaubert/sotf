# ----------------------------------------------------------------------
# plugins-nih: VST3/CLAP wrappers via nih-plug
# ----------------------------------------------------------------------
# One crate, 29 feature-gated plugins. Build each with --features <name>.

# All plugin features
NIH_FEATURES := "eq compressor limiter gate gain delay expander crossfeed saturation denoiser downmix mono-to-stereo stereo-imager transient-shaper de-esser dynamic-eq multiband-compressor multiband-expander convolution fletcher-munson loudness-compensation channel-mute-solo upmixer xtc binaural matrix pnd ab-compare crossover"

_lib_name := "libplugins_nih"

[group('lint')]
lint-nih:
	cargo check -p plugins-nih --features eq
	cargo clippy -p plugins-nih --features eq

[group('lint')]
lint-nih-all:
	#!/usr/bin/env bash
	set -euo pipefail
	for feat in {{NIH_FEATURES}}; do
		echo "Checking $feat..."
		cargo check -p plugins-nih --features "$feat" --no-default-features
	done

# Build all 29 plugin cdylibs (release)
[group('build')]
build-nih-all:
	#!/usr/bin/env bash
	set -euo pipefail
	# Find workspace root (where Cargo.lock is)
	ROOT=$(cargo metadata --no-deps --format-version=1 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['workspace_root'])" 2>/dev/null || echo "$(pwd)/../../../..")
	mkdir -p dist/nih
	for feat in {{NIH_FEATURES}}; do
		echo "Building $feat..."
		cargo build --release -p plugins-nih --features "$feat" --no-default-features
		lib_name="sotf_${feat//-/_}"
		cp "$ROOT/target/release/{{_lib_name}}.dylib" "dist/nih/lib${lib_name}.dylib"
	done
	echo "Built $(ls dist/nih/*.dylib | wc -l | tr -d ' ') plugins in dist/nih/"

# Build + bundle all VST3 plugins
[group('build')]
prod-vst3: build-nih-all
	#!/usr/bin/env bash
	set -euo pipefail
	VST3_DIR="dist/vst3"
	rm -rf "$VST3_DIR"
	for dylib in dist/nih/lib*.dylib; do
		base=$(basename "$dylib" .dylib | sed 's/^lib//')
		display=$(echo "$base" | sed 's/sotf_/SOTF /; s/_/ /g' | sed 's/\b\(.\)/\u\1/g')
		bundle="$VST3_DIR/${display}.vst3"
		mkdir -p "$bundle/Contents/MacOS"
		cp "$dylib" "$bundle/Contents/MacOS/${base}"
		printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0">\n<dict>\n\t<key>CFBundleExecutable</key>\n\t<string>%s</string>\n\t<key>CFBundleIdentifier</key>\n\t<string>org.spinorama.sotf.%s.vst3</string>\n\t<key>CFBundleName</key>\n\t<string>%s</string>\n\t<key>CFBundlePackageType</key>\n\t<string>BNDL</string>\n\t<key>CFBundleVersion</key>\n\t<string>1</string>\n</dict>\n</plist>\n' "$base" "$base" "$display" > "$bundle/Contents/Info.plist"
	done
	echo "Bundled $(ls -d "$VST3_DIR"/*.vst3 | wc -l | tr -d ' ') VST3 plugins"

# Build + bundle all CLAP plugins
[group('build')]
prod-clap: build-nih-all
	#!/usr/bin/env bash
	set -euo pipefail
	CLAP_DIR="dist/clap"
	rm -rf "$CLAP_DIR"
	mkdir -p "$CLAP_DIR"
	for dylib in dist/nih/lib*.dylib; do
		base=$(basename "$dylib" .dylib | sed 's/^lib//')
		cp "$dylib" "$CLAP_DIR/${base}.clap"
	done
	echo "Bundled $(ls "$CLAP_DIR"/*.clap | wc -l | tr -d ' ') CLAP plugins"

# Install VST3 plugins
[group('install')]
install-vst3: prod-vst3
	#!/usr/bin/env bash
	set -euo pipefail
	DEST="$HOME/Library/Audio/Plug-Ins/VST3"
	mkdir -p "$DEST"
	for bundle in dist/vst3/*.vst3; do
		name=$(basename "$bundle")
		rm -rf "$DEST/$name"
		cp -R "$bundle" "$DEST/$name"
	done
	echo "Installed $(ls -d "$DEST"/SOTF*.vst3 2>/dev/null | wc -l | tr -d ' ') VST3 plugins to $DEST"

# Install CLAP plugins
[group('install')]
install-clap: prod-clap
	#!/usr/bin/env bash
	set -euo pipefail
	DEST="$HOME/Library/Audio/Plug-Ins/CLAP"
	mkdir -p "$DEST"
	cp dist/clap/*.clap "$DEST/"
	echo "Installed $(ls "$DEST"/sotf_*.clap 2>/dev/null | wc -l | tr -d ' ') CLAP plugins to $DEST"

# Build + install everything
[group('install')]
install-nih-all: install-vst3 install-clap
