# Notarize + package both per-arch AU bundles.
[group('build-macos')]
sign-au-notarize: sign-au-notarize-arm64 sign-au-notarize-x86_64
	@echo "✅ Both per-arch .pkg installers notarized in dist/au/"

# ----------------------------------------------------------------------
# Distribute (per-arch .pkg installers into dist/au/)
# ----------------------------------------------------------------------
# If INSTALLER_DEVELOPER_ID is set, the pkg is signed; otherwise unsigned.
# For a fully signed + notarized pkg, use 'just sign-au-notarize' instead.

# Package the arm64 AU bundle into dist/au/ as a .pkg installer.
[group('build-macos')]
dist-au-arm64:
	#!/usr/bin/env bash
	set -euo pipefail
	VERSION=$(grep -m1 '^version = ' Cargo.toml | sed 's/version = "\(.*\)"/\1/')
	APP="{{au_dir}}/build/au-arm64/Build/Products/Release/SOTFAudioUnits.app"
	if [ ! -d "$APP" ]; then
		echo "No app bundle at $APP — run 'just build-au-all-arm64' first"
		exit 1
	fi
	BUNDLE_ID=$(/usr/bin/plutil -extract CFBundleIdentifier raw "$APP/Contents/Info.plist")
	if ! codesign --verify --strict "$APP" 2>/dev/null; then
		echo "WARNING: arm64 bundle is not signed. Run 'just sign-au-arm64' first for distribution."
		echo "Packaging unsigned bundle anyway..."
	fi
	mkdir -p dist/au
	PKG="dist/au/sotf-audio-units-${VERSION}-macos-arm64.pkg"

	if [ -n "${INSTALLER_DEVELOPER_ID:-}" ]; then
		UNSIGNED_PKG="/tmp/sotf-audio-units-arm64-unsigned.pkg"
		/usr/bin/pkgbuild \
			--component "$APP" \
			--install-location "/Applications" \
			--identifier "${BUNDLE_ID}.arm64.pkg" \
			--version "$VERSION" \
			"$UNSIGNED_PKG"
		/usr/bin/productsign \
			--sign "$INSTALLER_DEVELOPER_ID" \
			"$UNSIGNED_PKG" \
			"$PKG"
		rm -f "$UNSIGNED_PKG"
		/usr/sbin/pkgutil --check-signature "$PKG"
	else
		echo "WARNING: INSTALLER_DEVELOPER_ID not set; building unsigned pkg."
		/usr/bin/pkgbuild \
			--component "$APP" \
			--install-location "/Applications" \
			--identifier "${BUNDLE_ID}.arm64.pkg" \
			--version "$VERSION" \
			"$PKG"
	fi

	ls -lh "$PKG"
	echo "✅ Packaged: $PKG"

