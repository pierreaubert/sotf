# Package both per-arch AU bundles into dist/au/ as .pkg installers.
[group('build-macos')]
dist-au: dist-au-arm64 dist-au-x86_64
	@echo ""
	@echo "Distribution: users download the .pkg matching their Mac's architecture"
	@echo "and double-click to install. Installs to /Applications/SOTFAudioUnits.app —"
	@echo "launch it once to register the AUs."

# List registered SOTF Audio Units
[group('build-macos')]
list-au:
	@pluginkit -m -p com.apple.audio.AudioUnitv3 2>/dev/null | grep -i sotf || echo "No SOTF Audio Units registered"
