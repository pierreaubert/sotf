# ----------------------------------------------------------------------
# plugins-au: macOS Audio Unit v3 plugins
# ----------------------------------------------------------------------

au_dir := "crates/sotf-plugins/crates/plugins-au"
plugin_crates_dir := "crates/sotf-plugins/crates"

# Sync AU Info.plist versions from Cargo.toml (called automatically before builds)
[group('build-macos')]
sync-au-versions:
	#!/usr/bin/env bash
	set -eo pipefail
	AU_DIR="{{au_dir}}"
	CRATES="{{plugin_crates_dir}}"

	cargo_version() {
		local ver
		ver=$(grep '^version' "$1/Cargo.toml" | head -1 | sed 's/.*"\(.*\)"/\1/')
		# Handle version.workspace = true
		if [ -z "$ver" ] || echo "$ver" | grep -q "workspace"; then
			ver=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)"/\1/')
		fi
		echo "$ver"
	}

	WS_VERSION=$(cargo_version .)

	echo "Syncing AU versions from Cargo.toml..."

	# AU extension name → plugin crate name
	AU_NAMES=(  EQAudioUnit         CompressorAudioUnit     LimiterAudioUnit     GateAudioUnit     GainAudioUnit     DelayAudioUnit)
	CRATE_NAMES=(sotf-plugin-eq     sotf-plugin-multiband-compressor  sotf-plugin-limiter  sotf-plugin-gate  sotf-plugin-gain  sotf-plugin-delay)

	for i in "${!AU_NAMES[@]}"; do
		au="${AU_NAMES[$i]}"
		crate="${CRATE_NAMES[$i]}"
		version=$(cargo_version "$CRATES/$crate")
		plist="$AU_DIR/$au/Info.plist"
		if [ -f "$plist" ]; then
			plutil -replace CFBundleShortVersionString -string "$version" "$plist"
			echo "  $au → $version"
		fi
	done

	# App container MARKETING_VERSION in project.yml
	sed -i '' "s/MARKETING_VERSION: .*/MARKETING_VERSION: $WS_VERSION/" "$AU_DIR/project.yml"
	echo "  project.yml MARKETING_VERSION → $WS_VERSION"

# Build GPUI AU rendering library (universal binary)
[group('build-macos')]
build-au-gpui:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "Building gpui-au for x86_64 + aarch64..."
	cargo build --release -p gpui-au --target x86_64-apple-darwin
	cargo build --release -p gpui-au --target aarch64-apple-darwin
	mkdir -p crates/sotf-plugins/crates/plugins-au/Resources
	lipo -create \
		target/x86_64-apple-darwin/release/libgpui_au.a \
		target/aarch64-apple-darwin/release/libgpui_au.a \
		-output crates/sotf-plugins/crates/plugins-au/Resources/libsotf_gpui_au.a
	echo "Universal GPUI AU library: crates/sotf-plugins/crates/plugins-au/Resources/libsotf_gpui_au.a"

# Build Rust FFI library for Audio Units (universal binary)
[group('build-macos')]
build-au-ffi:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "Building plugins-ffi for x86_64 + aarch64..."
	cargo build --release -p plugins-ffi --target x86_64-apple-darwin
	cargo build --release -p plugins-ffi --target aarch64-apple-darwin
	mkdir -p crates/sotf-plugins/crates/plugins-au/Resources
	lipo -create \
		target/x86_64-apple-darwin/release/libplugins_ffi.a \
		target/aarch64-apple-darwin/release/libplugins_ffi.a \
		-output crates/sotf-plugins/crates/plugins-au/Resources/libsotf_audio_plugins_ffi.a
	echo "Universal FFI library: crates/sotf-plugins/crates/plugins-au/Resources/libsotf_audio_plugins_ffi.a"

# Generate Xcode project and build all AU extensions
[group('build-macos')]
build-au-xcode: sync-au-versions build-au-ffi
	#!/usr/bin/env bash
	set -euo pipefail
	cd crates/sotf-plugins/crates/plugins-au
	# Generate Xcode project with XcodeGen
	if [ ! -d "SOTFAudioUnits.xcodeproj" ] || [ "project.yml" -nt "SOTFAudioUnits.xcodeproj/project.pbxproj" ]; then
		echo "Generating Xcode project..."
		xcodegen generate
	fi
	# Build all AU targets
	xcodebuild -project SOTFAudioUnits.xcodeproj \
		-scheme SOTFAudioUnits \
		-configuration Release \
		build
	echo "All Audio Units built"

# Build complete AU pipeline (FFI + Xcode)
[group('build-macos')]
build-au-all: build-au-xcode

# Install Audio Units to system
[group('build-macos')]
install-au-all: build-au-all
	#!/usr/bin/env bash
	set -euo pipefail
	XCODE_APP=$(find ~/Library/Developer/Xcode/DerivedData/SOTFAudioUnits-*/Build/Products/Release/SOTFAudioUnits.app -maxdepth 0 2>/dev/null | head -1)
	if [ -n "$XCODE_APP" ] && [ -d "$XCODE_APP" ]; then
		rm -rf ~/Applications/SOTFAudioUnits.app
		mkdir -p ~/Applications
		cp -r "$XCODE_APP" ~/Applications/
		echo "SOTF Audio Units installed to ~/Applications/"
		echo "Launch the app once to register AU extensions with the system"
	else
		echo "No build found. Run 'just build-au-all' first."
		exit 1
	fi
	killall -9 AudioComponentRegistrar coreaudiod 2>/dev/null || true

# Validate all Audio Units with auval
[group('build-macos')]
validate-au-all:
	#!/usr/bin/env bash
	set -euo pipefail
	SUBTYPES=("SOEQ" "SOCP" "SOLM" "SOGT" "SOGN" "SODY")
	NAMES=("EQ" "Compressor" "Limiter" "Gate" "Gain" "Delay")
	FAILED=0
	for i in "${!SUBTYPES[@]}"; do
		echo "--- Validating ${NAMES[$i]} (${SUBTYPES[$i]}) ---"
		if auval -v aufx "${SUBTYPES[$i]}" SOTF; then
			echo "${NAMES[$i]}: PASS"
		else
			echo "${NAMES[$i]}: FAIL"
			FAILED=$((FAILED + 1))
		fi
	done
	if [ $FAILED -gt 0 ]; then
		echo "$FAILED AU(s) failed validation"
		exit 1
	fi
	echo "All Audio Units validated"

# Sign AU bundle with Developer ID (inside-out: appex first, then container)
# Requires: export DEVELOPER_ID="Developer ID Application: Your Name (TEAMID)"
[group('build-macos')]
sign-au:
	#!/usr/bin/env bash
	set -euo pipefail
	APP="$HOME/Applications/SOTFAudioUnits.app"
	if [ ! -d "$APP" ]; then
		echo "No app bundle at $APP — run 'just install-au-all' first"
		exit 1
	fi
	if [ -z "${DEVELOPER_ID:-}" ]; then
		echo "DEVELOPER_ID not set. Usage:"
		echo "  export DEVELOPER_ID='Developer ID Application: Your Name (TEAMID)'"
		echo "  just sign-au"
		exit 1
	fi
	# 1. Sign each AU extension (inside-out)
	for appex in "$APP"/Contents/PlugIns/*.appex; do
		echo "Signing $(basename "$appex")..."
		codesign --force --sign "$DEVELOPER_ID" \
			--options runtime \
			--timestamp \
			"$appex"
	done
	# 2. Sign the container app
	echo "Signing SOTFAudioUnits.app..."
	codesign --force --sign "$DEVELOPER_ID" \
		--options runtime \
		--timestamp \
		"$APP"
	# 3. Verify
	codesign --verify --verbose=2 --strict "$APP"
	echo "All AU plugins signed and verified"

# Sign and notarize AU bundle with Apple
# Requires: DEVELOPER_ID + APPLE_ID + keychain profile "autoeq-notarization"
[group('build-macos')]
sign-au-notarize: sign-au
	#!/usr/bin/env bash
	set -euo pipefail
	APP="$HOME/Applications/SOTFAudioUnits.app"
	if [ -z "${APPLE_ID:-}" ]; then
		echo "APPLE_ID not set for notarization"
		exit 1
	fi
	# Zip for notarization submission (notarytool requires zip/dmg/pkg)
	ZIP="/tmp/SOTFAudioUnits.zip"
	ditto -c -k --keepParent "$APP" "$ZIP"
	echo "Submitting for notarization..."
	xcrun notarytool submit "$ZIP" \
		--apple-id "$APPLE_ID" \
		--keychain-profile "autoeq-notarization" \
		--wait
	rm -f "$ZIP"
	# Staple the ticket to the app
	xcrun stapler staple "$APP"
	xcrun stapler validate "$APP"
	echo "AU bundle notarized and stapled"

# List registered SOTF Audio Units
[group('build-macos')]
list-au:
	@pluginkit -m -p com.apple.audio.AudioUnitv3 2>/dev/null | grep -i sotf || echo "No SOTF Audio Units registered"
