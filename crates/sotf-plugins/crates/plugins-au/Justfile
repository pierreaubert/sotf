# ----------------------------------------------------------------------
# plugins-au: macOS Audio Unit v3 plugins
# ----------------------------------------------------------------------
# Per-architecture pipeline. Each arch builds its own FFI/GPUI staticlib,
# its own Xcode .app (isolated -derivedDataPath), and produces an
# independently signable / notarizable / distributable bundle. The
# top-level recipes (build-au-all, sign-au, etc.) run both arches in
# sequence — the Resources/.a files are overwritten between archs but
# each xcodebuild step finishes before the next arch's cargo build
# replaces them, so the link inputs always match the arch under build.
#
# Outputs live at:
#   {{au_dir}}/build/au-arm64/Build/Products/Release/SOTFAudioUnits.app
#   {{au_dir}}/build/au-x86_64/Build/Products/Release/SOTFAudioUnits.app

au_dir := "crates/sotf-plugins/crates/plugins-au"
plugin_crates_dir := "crates/sotf-plugins/crates"

# Sync AU Info.plist versions from Cargo.toml (called automatically before builds)
[group('build-macos')]
sync-au-versions:
	#!/usr/bin/env bash
	set -eo pipefail
	AU_DIR="{{au_dir}}"
	CRATES="{{plugin_crates_dir}}"

	cargo_version() {
		local ver
		ver=$(grep '^version' "$1/Cargo.toml" | head -1 | sed 's/.*"\(.*\)"/\1/')
		# Handle version.workspace = true
		if [ -z "$ver" ] || echo "$ver" | grep -q "workspace"; then
			ver=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)"/\1/')
		fi
		echo "$ver"
	}

	WS_VERSION=$(cargo_version .)

	echo "Syncing AU versions from Cargo.toml..."

	# AU extension name → plugin crate name
	AU_NAMES=(  EQAudioUnit         CompressorAudioUnit                LimiterAudioUnit     GateAudioUnit     GainAudioUnit     DelayAudioUnit     AAEAudioUnit       BandSplitAudioUnit     BandMergeAudioUnit     AECAudioUnit     BeamformerAudioUnit     LinearPhaseEQAudioUnit     SpectralCompressorAudioUnit     LoudnessMonitorAudioUnit  SpectrumAnalyzerAudioUnit  AmbisonicsAudioUnit)
	CRATE_NAMES=(sotf-plugin-eq     sotf-plugin-multiband-compressor  sotf-plugin-limiter  sotf-plugin-gate  sotf-plugin-gain  sotf-plugin-delay  sotf-plugin-aae    sotf-plugin-band-split sotf-plugin-band-merge sotf-plugin-aec  sotf-plugin-beamformer  sotf-plugin-linear-phase-eq  sotf-plugin-spectral-compressor  sotf-host                 sotf-host                  sotf-plugin-ambisonics)

	# Apple requires all extensions to match the parent app's CFBundleShortVersionString,
	# so use the workspace version for everything (not individual crate versions).
	for i in "${!AU_NAMES[@]}"; do
		au="${AU_NAMES[$i]}"
		plist="$AU_DIR/$au/Info.plist"
		if [ -f "$plist" ]; then
			plutil -replace CFBundleShortVersionString -string "$WS_VERSION" "$plist"
			echo "  $au → $WS_VERSION"
		fi
	done

	# Also update any AU extensions not in the mapping above
	for plist in "$AU_DIR"/*AudioUnit/Info.plist; do
		if [ -f "$plist" ]; then
			plutil -replace CFBundleShortVersionString -string "$WS_VERSION" "$plist"
		fi
	done

	# App container MARKETING_VERSION in project.yml
	sed -i '' "s/MARKETING_VERSION: .*/MARKETING_VERSION: $WS_VERSION/" "$AU_DIR/project.yml"
	echo "  project.yml MARKETING_VERSION → $WS_VERSION"

# ----------------------------------------------------------------------
# GPUI AU rendering staticlib (per-arch)
# ----------------------------------------------------------------------

# Build the gpui-au staticlib for arm64 and stage it for the Xcode project.
[group('build-macos')]
build-au-gpui-arm64:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "Building gpui-au for aarch64..."
	cargo build --release -p gpui-au --target aarch64-apple-darwin
	mkdir -p {{au_dir}}/Resources
	cp target/aarch64-apple-darwin/release/libgpui_au.a \
		{{au_dir}}/Resources/libsotf_gpui_au.a
	echo "✅ GPUI AU library (arm64): {{au_dir}}/Resources/libsotf_gpui_au.a"

# Build the gpui-au staticlib for x86_64 and stage it for the Xcode project.
[group('build-macos')]
build-au-gpui-x86_64:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "Building gpui-au for x86_64..."
	cargo build --release -p gpui-au --target x86_64-apple-darwin
	mkdir -p {{au_dir}}/Resources
	cp target/x86_64-apple-darwin/release/libgpui_au.a \
		{{au_dir}}/Resources/libsotf_gpui_au.a
	echo "✅ GPUI AU library (x86_64): {{au_dir}}/Resources/libsotf_gpui_au.a"

# ----------------------------------------------------------------------
# Rust FFI staticlib (per-arch)
# ----------------------------------------------------------------------
# cargo emits target/<triple>/release/libplugins_ffi.a (crate name is
# `plugins-ffi`); the Xcode project links -lsotf_audio_plugins_ffi
# (project.yml:39), so we copy under that name into Resources/.

# Build the plugins-ffi staticlib for arm64 and stage it for the Xcode project.
[group('build-macos')]
build-au-ffi-arm64:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "Building plugins-ffi for aarch64..."
	cargo build --release -p plugins-ffi --target aarch64-apple-darwin
	mkdir -p {{au_dir}}/Resources
	cp target/aarch64-apple-darwin/release/libplugins_ffi.a \
		{{au_dir}}/Resources/libsotf_audio_plugins_ffi.a
	echo "✅ FFI library (arm64): {{au_dir}}/Resources/libsotf_audio_plugins_ffi.a"

# Build the plugins-ffi staticlib for x86_64 and stage it for the Xcode project.
[group('build-macos')]
build-au-ffi-x86_64:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "Building plugins-ffi for x86_64..."
	cargo build --release -p plugins-ffi --target x86_64-apple-darwin
	mkdir -p {{au_dir}}/Resources
	cp target/x86_64-apple-darwin/release/libplugins_ffi.a \
		{{au_dir}}/Resources/libsotf_audio_plugins_ffi.a
	echo "✅ FFI library (x86_64): {{au_dir}}/Resources/libsotf_audio_plugins_ffi.a"

# ----------------------------------------------------------------------
# Xcode build (per-arch)
# ----------------------------------------------------------------------

# Build all AU extensions for arm64 (Xcode, isolated DerivedData).
[group('build-macos')]
build-au-xcode-arm64: sync-au-versions build-au-ffi-arm64
	#!/usr/bin/env bash
	set -euo pipefail
	cd {{au_dir}}
	if [ ! -d "SOTFAudioUnits.xcodeproj" ] || [ "project.yml" -nt "SOTFAudioUnits.xcodeproj/project.pbxproj" ]; then
		echo "Generating Xcode project..."
		xcodegen generate
	fi
	rm -rf build/au-arm64
	xcodebuild -project SOTFAudioUnits.xcodeproj \
		-scheme SOTFAudioUnits \
		-configuration Release \
		-derivedDataPath build/au-arm64 \
		ARCHS=arm64 \
		ONLY_ACTIVE_ARCH=NO \
		build
	echo "✅ All Audio Units built for arm64: build/au-arm64/Build/Products/Release/SOTFAudioUnits.app"

# Build all AU extensions for x86_64 (Xcode, isolated DerivedData).
[group('build-macos')]
build-au-xcode-x86_64: sync-au-versions build-au-ffi-x86_64
	#!/usr/bin/env bash
	set -euo pipefail
	cd {{au_dir}}
	if [ ! -d "SOTFAudioUnits.xcodeproj" ] || [ "project.yml" -nt "SOTFAudioUnits.xcodeproj/project.pbxproj" ]; then
		echo "Generating Xcode project..."
		xcodegen generate
	fi
	rm -rf build/au-x86_64
	xcodebuild -project SOTFAudioUnits.xcodeproj \
		-scheme SOTFAudioUnits \
		-configuration Release \
		-derivedDataPath build/au-x86_64 \
		ARCHS=x86_64 \
		ONLY_ACTIVE_ARCH=NO \
		build
	echo "✅ All Audio Units built for x86_64: build/au-x86_64/Build/Products/Release/SOTFAudioUnits.app"

# ----------------------------------------------------------------------
# Full build pipelines (per-arch)
# ----------------------------------------------------------------------

# Build the complete AU pipeline (FFI + Xcode) for arm64.
[group('build-macos')]
build-au-all-arm64: build-au-xcode-arm64 sync-au-versions

# Build the complete AU pipeline (FFI + Xcode) for x86_64.
[group('build-macos')]
build-au-all-x86_64: build-au-xcode-x86_64 sync-au-versions

# Build the complete AU pipeline for both archs sequentially.
[group('build-macos')]
build-au-all: build-au-all-arm64 build-au-all-x86_64
	@echo "✅ AU packages built for arm64 and x86_64"

# Validate all Audio Units with auval (against whichever arch is currently registered).
[group('build-macos')]
validate-au-all:
	#!/usr/bin/env bash
	set -euo pipefail
	SUBTYPES=("SOEQ" "SOCP" "SOLM" "SOGT" "SOGN" "SODY" "SOAE" "SOBS" "SOBM" "SOEc" "SOBF" "SOLP" "SOSC" "SOLu" "SOSa" "SOAm")
	NAMES=("EQ" "Compressor" "Limiter" "Gate" "Gain" "Delay" "AAE" "BandSplit" "BandMerge" "AEC" "Beamformer" "LinearPhaseEQ" "SpectralCompressor" "LoudnessMonitor" "SpectrumAnalyzer" "Ambisonics")
	FAILED=0
	for i in "${!SUBTYPES[@]}"; do
		echo "--- Validating ${NAMES[$i]} (${SUBTYPES[$i]}) ---"
		if auval -v aufx "${SUBTYPES[$i]}" SOTF; then
			echo "${NAMES[$i]}: PASS"
		else
			echo "${NAMES[$i]}: FAIL"
			FAILED=$((FAILED + 1))
		fi
	done
	if [ $FAILED -gt 0 ]; then
		echo "$FAILED AU(s) failed validation"
		exit 1
	fi
	echo "All Audio Units validated"

# ----------------------------------------------------------------------
# Sign (per-arch + sign both)
# ----------------------------------------------------------------------
# Signs the per-arch BUILD output directly (not the installed app), so
# each arch ends up with a signed bundle ready for notarization and
# distribution. Inside-out: appex first, then container.
# Requires: export DEVELOPER_ID="Developer ID Application: Your Name (TEAMID)"

# Sign the arm64 AU bundle.
[group('build-macos')]
sign-au-arm64:
	#!/usr/bin/env bash
	set -euo pipefail
	APP="{{au_dir}}/build/au-arm64/Build/Products/Release/SOTFAudioUnits.app"
	if [ ! -d "$APP" ]; then
		echo "No app bundle at $APP — run 'just build-au-all-arm64' first"
		exit 1
	fi
	if [ -z "${DEVELOPER_ID:-}" ]; then
		echo "DEVELOPER_ID not set. Usage:"
		echo "  export DEVELOPER_ID='Developer ID Application: Your Name (TEAMID)'"
		echo "  just sign-au-arm64"
		exit 1
	fi
	for appex in "$APP"/Contents/PlugIns/*.appex; do
		echo "Signing $(basename "$appex")..."
		codesign --force --sign "$DEVELOPER_ID" --options runtime --timestamp "$appex"
	done
	echo "Signing SOTFAudioUnits.app (arm64)..."
	codesign --force --sign "$DEVELOPER_ID" --options runtime --timestamp "$APP"
	codesign --verify --verbose=2 --strict "$APP"
	echo "✅ arm64 AU bundle signed and verified"

# Sign the x86_64 AU bundle.
[group('build-macos')]
sign-au-x86_64:
	#!/usr/bin/env bash
	set -euo pipefail
	APP="{{au_dir}}/build/au-x86_64/Build/Products/Release/SOTFAudioUnits.app"
	if [ ! -d "$APP" ]; then
		echo "No app bundle at $APP — run 'just build-au-all-x86_64' first"
		exit 1
	fi
	if [ -z "${DEVELOPER_ID:-}" ]; then
		echo "DEVELOPER_ID not set. Usage:"
		echo "  export DEVELOPER_ID='Developer ID Application: Your Name (TEAMID)'"
		echo "  just sign-au-x86_64"
		exit 1
	fi
	for appex in "$APP"/Contents/PlugIns/*.appex; do
		echo "Signing $(basename "$appex")..."
		codesign --force --sign "$DEVELOPER_ID" --options runtime --timestamp "$appex"
	done
	echo "Signing SOTFAudioUnits.app (x86_64)..."
	codesign --force --sign "$DEVELOPER_ID" --options runtime --timestamp "$APP"
	codesign --verify --verbose=2 --strict "$APP"
	echo "✅ x86_64 AU bundle signed and verified"

# Sign both per-arch AU bundles.
[group('build-macos')]
sign-au: sign-au-arm64 sign-au-x86_64
	@echo "✅ Both per-arch AU bundles signed"

# ----------------------------------------------------------------------
# Notarize + package as .pkg (per-arch + both)
# ----------------------------------------------------------------------
# Each recipe: notarize + staple the .app, then build/sign/notarize/staple
# a Developer ID Installer .pkg into dist/au/.
# Requires: DEVELOPER_ID + INSTALLER_DEVELOPER_ID + APPLE_ID + keychain profile "autoeq-notarization"
#   DEVELOPER_ID           = "Developer ID Application: Your Name (TEAMID)"
#   INSTALLER_DEVELOPER_ID = "Developer ID Installer: Your Name (TEAMID)"

# Notarize and package the arm64 AU bundle into a signed/notarized .pkg.
[group('build-macos')]
sign-au-notarize-arm64: sign-au-arm64
	#!/usr/bin/env bash
	set -euo pipefail
	APP="{{au_dir}}/build/au-arm64/Build/Products/Release/SOTFAudioUnits.app"
	if [ -z "${APPLE_ID:-}" ]; then
		echo "APPLE_ID not set for notarization"
		exit 1
	fi
	if [ -z "${INSTALLER_DEVELOPER_ID:-}" ]; then
		echo "INSTALLER_DEVELOPER_ID not set. Usage:"
		echo "  export INSTALLER_DEVELOPER_ID='Developer ID Installer: Your Name (TEAMID)'"
		exit 1
	fi

	VERSION=$(grep -m1 '^version = ' Cargo.toml | sed 's/version = "\(.*\)"/\1/')
	BUNDLE_ID=$(/usr/bin/plutil -extract CFBundleIdentifier raw "$APP/Contents/Info.plist")

	# 1. Notarize and staple the .app (ticket embedded for offline Gatekeeper trust).
	APP_ZIP="/tmp/SOTFAudioUnits-arm64.zip"
	ditto -c -k --keepParent "$APP" "$APP_ZIP"
	echo "Submitting arm64 .app for notarization..."
	xcrun notarytool submit "$APP_ZIP" \
		--apple-id "$APPLE_ID" \
		--keychain-profile "autoeq-notarization" \
		--wait
	rm -f "$APP_ZIP"
	xcrun stapler staple "$APP"
	xcrun stapler validate "$APP"

	# 2. Build, sign, notarize, staple the installer .pkg.
	mkdir -p dist/au
	PKG="dist/au/sotf-audio-units-${VERSION}-macos-arm64.pkg"
	UNSIGNED_PKG="/tmp/sotf-audio-units-arm64-unsigned.pkg"
	/usr/bin/pkgbuild \
		--component "$APP" \
		--install-location "/Applications" \
		--identifier "${BUNDLE_ID}.arm64.pkg" \
		--version "$VERSION" \
		"$UNSIGNED_PKG"
	/usr/bin/productsign \
		--sign "$INSTALLER_DEVELOPER_ID" \
		"$UNSIGNED_PKG" \
		"$PKG"
	rm -f "$UNSIGNED_PKG"
	/usr/sbin/pkgutil --check-signature "$PKG"

	echo "Submitting arm64 .pkg for notarization..."
	xcrun notarytool submit "$PKG" \
		--apple-id "$APPLE_ID" \
		--keychain-profile "autoeq-notarization" \
		--wait
	xcrun stapler staple "$PKG"
	xcrun stapler validate "$PKG"
	echo "✅ arm64 .pkg notarized and stapled: $PKG"

