[group('bench')]
bench-plugins:
	cargo bench -p sotf-plugin-binaural --bench binaural-decoder-benchmark
	cargo bench -p sotf-plugin-upmixer --bench upmixer-benchmark

# ----------------------------------------------------------------------
# QA PLUGINS
# ----------------------------------------------------------------------

[group('qa-plugins')]
qa-plugins: qa-plugin-fuzzer qa-plugin-diagnostics

[group('qa-plugins')]
qa-plugin-fuzzer: qa-plugin-fuzzer-simple qa-plugin-fuzzer-1ch qa-plugin-fuzzer-2ch qa-plugin-fuzzer-6ch

[group('qa-plugins')]
qa-plugin-fuzzer-simple:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_*.wav; do \
		for plugin in gain eq compressor limiter gate delay loudness_monitor abcompare expander mbcomp mbexp matrix mutesolo denoiser spectrum pnd; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('qa-plugins')]
qa-plugin-fuzzer-1ch:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_ch1_*.wav; do \
		for plugin in mono_to_stereo; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('qa-plugins')]
qa-plugin-fuzzer-2ch:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_ch2_*.wav; do \
		for plugin in fletcher upmixer xtc crossfeed; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('qa-plugins')]
qa-plugin-fuzzer-6ch:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_ch6_*.wav; do \
		for plugin in downmix; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('qa-plugins')]
qa-plugin-diagnostics:
	cargo run --release --package sotf-plugin-ab-compare --bin qa-ab-compare --features qa
	cargo run --release --package sotf-plugin-delay --bin qa-delay --features qa
	cargo run --release --package sotf-plugin-downmix --bin qa-downmix --features qa
	cargo run --release --package sotf-plugin-eq --bin qa-eq --features qa
	cargo run --release --package sotf-plugin-gain --bin qa-gain --features qa
	cargo run --release --package sotf-plugin-gate --bin qa-gate --features qa
	cargo run --release --package sotf-plugin-limiter --bin qa-limiter --features qa
	cargo run --release --package sotf-plugin-loudness-compensation --bin qa-loudness-compensation --features qa
	cargo run --release --package sotf-plugin-mono-to-stereo --bin qa-mono-to-stereo --features qa
	cargo run --release --package sotf-plugin-multiband-compressor --bin qa-multiband-compressor --features qa
	cargo run --release --package sotf-plugin-multiband-expander --bin qa-multiband-expander --features qa
	cargo run --release --package sotf-plugin-pnd --bin qa-pnd --features qa
	cargo run --release --package sotf-plugin-upmixer --bin qa-upmixer --features qa
	cargo run --release --package sotf-plugin-xtc --bin qa-xtc --features qa

