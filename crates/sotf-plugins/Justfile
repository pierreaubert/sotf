# ----------------------------------------------------------------------
# QA FUZZER
# ----------------------------------------------------------------------

[group('plugins')]
qa-plugins-fuzzer: qa-plugins-fuzzer-simple qa-plugins-fuzzer-1ch qa-plugins-fuzzer-2ch qa-plugins-fuzzer-6ch

[group('plugins')]
qa-plugins-fuzzer-simple:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_*.wav; do \
		for plugin in gain eq compressor limiter gate delay loudness_monitor abcompare expander mbcomp mbexp matrix mutesolo denoiser spectrum pnd; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('plugins')]
qa-plugins-fuzzer-1ch:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_ch1_*.wav; do \
		for plugin in mono_to_stereo; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('plugins')]
qa-plugins-fuzzer-2ch:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_ch2_*.wav; do \
		for plugin in fletcher upmixer xtc crossfeed; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

[group('plugins')]
qa-plugins-fuzzer-6ch:
	@for file in ./data_generated/test-audio/wav/pink_noise/pink_noise_ch6_*.wav; do \
		for plugin in downmix; do \
			echo "=== Fuzzing plugin: $plugin with $file ==="; \
			cargo run --release --bin plugin-fuzzer -- --file "$file" --plugin $plugin || exit 1; \
		done; \
	done

