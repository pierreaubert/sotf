<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime entitlements for Developer ID direct distribution
         (DMG / GitHub Releases). For Mac App Store submission, see
         entitlements-mas.plist instead. -->

    <!-- Sandboxing is OFF on this path: SotF reads/writes arbitrary
         user-chosen library locations, plugin-preset directories, log files,
         and config files outside any container. The Mac App Store build
         flips this to true and adds security-scoped bookmark machinery. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow JIT compilation. RustFFT 6.x does not actually JIT (it ships
         statically compiled SIMD), but objc2 selector machinery can
         allocate executable pages on first message-send; keeping this on
         is harmless and MAS-allowed too. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Audio Input (room measurement / calibration recording) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Camera (SOTF API QR-code server setup) -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- File Access (NSOpenPanel-driven user-selected dirs and files) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Network (api.spinorama.org metadata, headphone-EQ database) -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
