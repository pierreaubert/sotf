# Build stage - inherits build context from build.x86_64-unknown-linux-gnu
# This image is meant to be used as: FROM sotf-build-linux-x86-gnu
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV OPENSSL_STATIC=1
ENV OPENSSL_VENDORED=1
ENV AUTOEQ_DIR=/workspace/autoeq

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    gcc \
    g++ \
    pkg-config \
    ca-certificates \
    cmake \
    ninja-build \
    perl \
    libssl-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install the pinned Rust 1.99.0 toolchain.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.99.0 --profile minimal && \
    rm -rf /root/.cargo/registry /root/.cargo/git

ENV PATH="/root/.cargo/bin:${PATH}"
ENV RUSTUP_TOOLCHAIN=1.99.0

# Add the target
RUN rustup target add x86_64-unknown-linux-gnu

# Install just (command runner)
RUN cargo install just && \
    rm -rf /root/.cargo/registry /root/.cargo/git

WORKDIR /workspace/sotf
