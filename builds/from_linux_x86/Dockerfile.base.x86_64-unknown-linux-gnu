# Multi-stage build: Builder stage
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install Rust 1.90 and build dependencies - combined into single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    gcc \
    g++ \
    pkg-config \
    ca-certificates \
    cmake \
    ninja-build \
    perl \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp*

# Install Rust 1.90 (pinned version for compatibility)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.90.0 --profile minimal && \
    rm -rf /root/.cargo/registry /root/.cargo/git

ENV PATH="/root/.cargo/bin:${PATH}"

# Add the target
RUN rustup target add x86_64-unknown-linux-gnu

# Install just (command runner)
RUN cargo install just --locked && \
    rm -rf /root/.cargo/registry /root/.cargo/git

WORKDIR /project

# Copy source with .dockerignore in place
COPY . .

# Build release binary
ARG APP_NAME=app-cli
RUN cargo build --release --target x86_64-unknown-linux-gnu && \
    find target/x86_64-unknown-linux-gnu/release -maxdepth 1 -type f -executable | xargs strip -v 2>/dev/null || true && \
    rm -rf target/.rustc_info.json target/.fingerprint target/x86_64-unknown-linux-gnu/release/deps/*.d

# Runtime stage: minimal base
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install only runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /home/appuser

# Copy only the compiled binary from builder
ARG APP_NAME=app-cli
COPY --from=builder --chown=appuser:appuser /project/target/x86_64-unknown-linux-gnu/release/${APP_NAME} /usr/local/bin/app

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD app --version || exit 1

# Set entrypoint
ENTRYPOINT ["app"]
CMD ["--help"]
