<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="SotF.SotF"
    Publisher="CN=817DD0F7-95A7-40FF-AD7A-90E15D2F89AD"
    Version="0.6.8"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SotF</DisplayName>
    <PublisherDisplayName>SotF</PublisherDisplayName>
    <Description>Sound of the Future - High-quality audio player with audio plugins and room eq</Description>
    <Logo>assets\sotf-44x44.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!-- Microsoft Visual C++ 2015-2022 Runtime, framework-package form. The
         desktop binary is built with -msvc (no +crt-static), so it imports
         VCRUNTIME140.dll / MSVCP140.dll / UCRT at load time. Declaring this
         dependency makes deployment refuse to install when VCLibs is missing,
         which is better than a silent "exe won't start" on a fresh Windows box.
         For sideloaded MSIX, the user installs the VCLibs framework package
         once (see RELEASE-HOWTO.md). The Store pulls it in automatically. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop"
                       MinVersion="14.0.30704.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- SotF GPUI Player -->
    <Application Id="SotFDesktop"
      Executable="sotf-desktop.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="SotF"
        Description="Sound of the Future - Audio Player"
        BackgroundColor="#1a1a2e"
        Square150x150Logo="assets\sotf-150x150.png"
        Square44x44Logo="assets\sotf-44x44.png">
        <uap:DefaultTile Wide310x150Logo="assets\sotf-310x150.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- File type associations for audio formats -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="audiofiles">
            <uap:DisplayName>Audio File</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.alac</uap:FileType>
              <uap:FileType>.mp4</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>

    <!-- SotF TUI is shipped as a standalone download from spinorama.org rather
         than as a second <Application> in this MSIX. Including it here would
         either (a) require AppListEntry="none" plus the HeadlessAppBypass
         Store waiver, or (b) clutter the user's Start menu with a duplicate
         "SotF TUI" tile that 99% of Store users won't want. -->
  </Applications>

  <Capabilities>
    <uap:Capability Name="musicLibrary" />
    <uap:Capability Name="removableStorage" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
