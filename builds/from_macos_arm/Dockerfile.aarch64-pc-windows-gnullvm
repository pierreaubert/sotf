# Multi-stage build: Builder stage for Windows cross-compilation
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install build dependencies - combined into single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    gcc \
    g++ \
    pkg-config \
    ca-certificates \
    cmake \
    ninja-build \
    perl \
    zip \
    openssl \
    osslsigncode \
    libxml2-utils \
    libssl-dev \
    mingw-w64 \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install the release Rust toolchain (pinned).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.99.0 --profile minimal && \
    rm -rf /root/.cargo/registry /root/.cargo/git

ENV PATH="/root/.cargo/bin:${PATH}"
# Keep Docker builds on the pinned toolchain even when the mounted workspace
# contains rust-toolchain.toml with channel = "stable".
ENV RUSTUP_TOOLCHAIN=1.99.0

# Add the Windows target
RUN rustup target add --toolchain 1.99.0 aarch64-pc-windows-gnullvm

# Install just
RUN cargo install just && \
    rm -rf /root/.cargo/registry /root/.cargo/git

ARG LLVM_MINGW_VERSION=20260421
ARG LLVM_MINGW_CRT=ucrt
ARG LLVM_MINGW_UBUNTU=22.04
ARG LLVM_MINGW_HOST=aarch64

# Ubuntu mingw-w64 does not provide Windows ARM64 tools. llvm-mingw supplies
# the aarch64-w64-mingw32 clang/LLD wrappers required by the gnullvm target.
RUN curl -fsSL "https://github.com/mstorsjo/llvm-mingw/releases/download/${LLVM_MINGW_VERSION}/llvm-mingw-${LLVM_MINGW_VERSION}-${LLVM_MINGW_CRT}-ubuntu-${LLVM_MINGW_UBUNTU}-${LLVM_MINGW_HOST}.tar.xz" | \
    tar -xJ -C /opt && \
    mv "/opt/llvm-mingw-${LLVM_MINGW_VERSION}-${LLVM_MINGW_CRT}-ubuntu-${LLVM_MINGW_UBUNTU}-${LLVM_MINGW_HOST}" /opt/llvm-mingw

# Some crates (e.g. rappct) emit MSVC-style capitalized link names
# (Userenv, Advapi32, Kernel32). LLD searches the mingw sysroot
# case-sensitively and only ships lowercase import libraries, so provide
# capitalized aliases or the gnullvm link fails.
RUN for pair in userenv:Userenv advapi32:Advapi32 kernel32:Kernel32; do \
        lower="${pair%%:*}"; upper="${pair##*:}"; \
        for dir in /opt/llvm-mingw/*-w64-mingw32/lib; do \
            if [ -f "$dir/lib${lower}.a" ]; then cp "$dir/lib${lower}.a" "$dir/lib${upper}.a"; fi; \
        done; \
    done

ENV PATH="/opt/llvm-mingw/bin:${PATH}"
ENV CC_aarch64_pc_windows_gnullvm=aarch64-w64-mingw32-clang
ENV CXX_aarch64_pc_windows_gnullvm=aarch64-w64-mingw32-clang++
ENV AR_aarch64_pc_windows_gnullvm=aarch64-w64-mingw32-ar
ENV CARGO_TARGET_AARCH64_PC_WINDOWS_GNULLVM_LINKER=aarch64-w64-mingw32-clang
ENV CARGO_TARGET_AARCH64_PC_WINDOWS_GNULLVM_AR=aarch64-w64-mingw32-ar

WORKDIR /workspace/sotf
