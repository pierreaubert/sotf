FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# System packages
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    cmake \
    ninja-build \
    ca-certificates \
    xz-utils \
    zip \
    openssl \
    osslsigncode \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none
ENV PATH="/root/.cargo/bin:${PATH}"

# Install the exact Rust version required by rust-toolchain.toml with all components
RUN rustup toolchain install 1.95.0-x86_64-unknown-linux-gnu --component cargo,clippy,llvm-tools-preview,rust-analyzer,rust-src,rust-std,rustc,rustc-dev,rustfmt && \
    rustup target add --toolchain 1.95.0-x86_64-unknown-linux-gnu x86_64-pc-windows-gnullvm && \
    rustup default 1.95.0-x86_64-unknown-linux-gnu

# Pin toolchain to override rust-toolchain.toml
ENV RUSTUP_TOOLCHAIN=1.95.0-x86_64-unknown-linux-gnu

RUN mkdir -p /root/.rustup/tmp /root/.rustup/downloads && \
    chmod -R 777 /root/.rustup/tmp /root/.rustup/downloads

# Install llvm-mingw (provides x86_64-w64-mingw32 toolchain)
RUN cd /opt && \
    curl -L -o llvm-mingw.tar.xz \
        https://github.com/mstorsjo/llvm-mingw/releases/download/20260311/llvm-mingw-20260311-ucrt-ubuntu-22.04-x86_64.tar.xz && \
    tar xf llvm-mingw.tar.xz && \
    rm llvm-mingw.tar.xz && \
    mv llvm-mingw-* llvm-mingw

ENV PATH="/opt/llvm-mingw/bin:${PATH}"

RUN cargo install just --locked

# Repair rustup state (cached layers may have stale component manifests)
RUN rustup component remove clippy 2>/dev/null; rustup component add clippy

# Pre-fetch cargo dependencies (cached per Cargo.lock)
WORKDIR /project
COPY . /project/
RUN cargo fetch --locked --target x86_64-pc-windows-gnullvm
RUN rm -rf /project/*
