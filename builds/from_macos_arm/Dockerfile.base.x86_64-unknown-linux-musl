FROM --platform=linux/amd64 messense/rust-musl-cross:x86_64-musl

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && rm -rf /var/lib/apt/lists/*

# Pre-install the exact Rust version required by rust-toolchain.toml with all components
RUN rustup toolchain install 1.95.0-x86_64-unknown-linux-gnu --component cargo,clippy,llvm-tools-preview,rust-analyzer,rust-src,rust-std,rustc,rustc-dev,rustfmt && \
    rustup target add --toolchain 1.95.0-x86_64-unknown-linux-gnu x86_64-unknown-linux-musl && \
    rustup default 1.95.0-x86_64-unknown-linux-gnu

# Pin toolchain to override rust-toolchain.toml (which requests "stable" and triggers broken syncs)
ENV RUSTUP_TOOLCHAIN=1.95.0-x86_64-unknown-linux-gnu

RUN mkdir -p /root/.rustup/tmp /root/.rustup/downloads && \
    chmod -R 777 /root/.rustup/tmp /root/.rustup/downloads

RUN cargo install just --locked

# System packages
WORKDIR /project
COPY Justfile /project/Justfile
COPY builds/linux.just /project/builds/linux.just
ENV JUST_JUSTFILE=/project/Justfile

RUN just install-linux-root
RUN just install-ubuntu-common
RUN apt-get update && apt-get install -y imagemagick && rm -rf /var/lib/apt/lists/*

# Install linuxdeploy for AppImage packaging (extracted — FUSE not available in Docker)
# NOTE: --appimage-extract fails under QEMU emulation (from macOS ARM).
# When building on native x86_64, this works; from ARM, use --tui-only to skip AppImage.
RUN cd /tmp && \
    curl -L -o linuxdeploy.AppImage \
        https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage && \
    chmod +x linuxdeploy.AppImage && \
    (./linuxdeploy.AppImage --appimage-extract && \
     mv squashfs-root /opt/linuxdeploy && \
     ln -sf /opt/linuxdeploy/AppRun /usr/local/bin/linuxdeploy || \
     echo "WARN: linuxdeploy extraction failed (QEMU?), AppImage creation will be unavailable") && \
    rm -f /tmp/linuxdeploy.AppImage

# Remove stale stable toolchain from base image (its clippy manifest is broken)
# and repair the default toolchain's clippy state
RUN rustup toolchain uninstall stable 2>/dev/null; \
    rustup component remove clippy 2>/dev/null; rustup component add clippy

# Pre-fetch cargo dependencies (cached per Cargo.lock)
COPY . /project/
RUN cargo fetch --locked --target x86_64-unknown-linux-gnu
RUN rm -rf /project/*
