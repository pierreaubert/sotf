# Multi-stage build: Builder stage
FROM --platform=linux/amd64 messense/rust-musl-cross:x86_64-musl AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install additional dependencies for audio and build tools - combined into single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    perl \
    pkg-config \
    gfortran \
    make \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install just (command runner)
RUN cargo install just --locked && \
    rm -rf /root/.cargo/registry /root/.cargo/git

# Set up environment for static linking
ENV RUSTFLAGS="-C target-feature=+crt-static"
ENV PKG_CONFIG_ALL_STATIC=1
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV OPENSSL_STATIC=1
ENV OPENSSL_VENDORED=1

WORKDIR /project

# Copy source with .dockerignore in place
COPY . .

# Build release binary
RUN cargo build --release --target x86_64-unknown-linux-musl && \
    find target/x86_64-unknown-linux-musl/release -maxdepth 1 -type f -executable | xargs strip -v 2>/dev/null || true && \
    rm -rf target/.rustc_info.json target/.fingerprint target/x86_64-unknown-linux-musl/release/deps/*.d
