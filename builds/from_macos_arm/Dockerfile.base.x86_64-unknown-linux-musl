# Multi-stage build: Builder stage
FROM --platform=linux/amd64 messense/rust-musl-cross:x86_64-musl AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install additional dependencies for audio and build tools - combined into single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    perl \
    pkg-config \
    gfortran \
    make \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# The upstream cross image can move independently of the workspace toolchain.
RUN rustup toolchain install 1.99.0-x86_64-unknown-linux-gnu --component cargo,clippy,llvm-tools-preview,rust-analyzer,rust-src,rust-std,rustc,rustc-dev,rustfmt && \
    rustup target add --toolchain 1.99.0-x86_64-unknown-linux-gnu x86_64-unknown-linux-musl && \
    rustup default 1.99.0-x86_64-unknown-linux-gnu

ENV RUSTUP_TOOLCHAIN=1.99.0-x86_64-unknown-linux-gnu

# Install just (command runner)
RUN cargo install just && \
    rm -rf /root/.cargo/registry /root/.cargo/git

# Set up environment for static linking
ENV RUSTFLAGS="-C target-feature=+crt-static"
ENV PKG_CONFIG_ALL_STATIC=1
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV OPENSSL_STATIC=1
ENV OPENSSL_VENDORED=1

WORKDIR /workspace/sotf
