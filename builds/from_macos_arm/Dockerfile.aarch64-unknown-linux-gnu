FROM sotf-base-linux-arm64-gnu

# Set up cross-compilation environment
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++
ENV AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc

# OpenSSL configuration for cross-compilation - force vendored OpenSSL
ENV OPENSSL_NO_PKG_CONFIG=1

# Set browser and webdriver paths for plotly_static
ENV BROWSER_PATH=/usr/bin/firefox
ENV WEBDRIVER_PATH=/root/bin/geckodriver
ENV PATH="/root/bin:${PATH}"

ENV CARGO_TARGET_DIR=/build-target
