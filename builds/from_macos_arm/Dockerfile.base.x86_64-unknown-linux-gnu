FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Install base build dependencies
RUN apt-get update && \
    apt-get install -y \
    curl \
    build-essential \
    gcc \
    g++ \
    pkg-config \
    libssl-dev \
    ca-certificates \
    cmake \
    ninja-build \
    perl \
    && rm -rf /var/lib/apt/lists/*

# Install Rust 1.95 (pinned version for compatibility)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.95.0 --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Add the target
RUN rustup target add x86_64-unknown-linux-gnu

# Install just (command runner)
RUN cargo install just --locked

# Install GTK and WebKit dependencies for Tauri
RUN apt-get update && \
    apt-get install -y \
    libglib2.0-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    chromium-browser \
    chromium-chromedriver \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /project

# Repair rustup state (cached layers may have stale component manifests)
RUN rustup component remove clippy 2>/dev/null; rustup component add clippy

# Pre-fetch cargo dependencies (cached per Cargo.lock)
COPY . /project/
RUN cargo fetch --locked --target x86_64-unknown-linux-gnu
RUN rm -rf /project/*
