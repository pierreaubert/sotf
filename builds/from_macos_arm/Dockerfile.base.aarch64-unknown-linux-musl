# Multi-stage build: Builder stage - for truly musl static builds
FROM messense/rust-musl-cross:aarch64-musl AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install additional dependencies - combined into single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    perl \
    pkg-config \
    gfortran \
    make \
    imagemagick \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install and pin Rust 1.95 for aarch64-unknown-linux-musl
RUN rustup toolchain install 1.95.0-aarch64-unknown-linux-gnu --component cargo,clippy,llvm-tools-preview,rust-analyzer,rust-src,rust-std,rustc,rustc-dev,rustfmt && \
    rustup target add --toolchain 1.95.0-aarch64-unknown-linux-gnu aarch64-unknown-linux-musl && \
    rustup default 1.95.0-aarch64-unknown-linux-gnu

ENV RUSTUP_TOOLCHAIN=1.95.0-aarch64-unknown-linux-gnu

RUN mkdir -p /root/.rustup/tmp /root/.rustup/downloads && \
    chmod -R 777 /root/.rustup/tmp /root/.rustup/downloads

RUN cargo install just --locked && \
    rm -rf /root/.cargo/registry /root/.cargo/git

# Repair clippy state
RUN rustup toolchain uninstall stable 2>/dev/null; \
    rustup component remove clippy 2>/dev/null; rustup component add clippy

# Set up environment for static linking
ENV RUSTFLAGS="-C target-feature=+crt-static"
ENV PKG_CONFIG_ALL_STATIC=1
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV OPENSSL_STATIC=1
ENV OPENSSL_VENDORED=1

WORKDIR /project

# Copy source with .dockerignore in place
COPY . .

# Build release binary for musl
RUN cargo build --release --target aarch64-unknown-linux-musl && \
    find target/aarch64-unknown-linux-musl/release -maxdepth 1 -type f -executable | xargs strip -v 2>/dev/null || true && \
    rm -rf target/.rustc_info.json target/.fingerprint target/aarch64-unknown-linux-musl/release/deps/*.d
