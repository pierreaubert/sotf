---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import Tutorials from '../components/Tutorials.astro';
import WhySotF from '../components/WhySotF.astro';
import Download from '../components/Download.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="SotF — Sound of the Future"
  description="Your room, your headphones, your sound — scientifically optimized. Free, open source audio optimization for audiophiles and home theater enthusiasts."
>
  <Nav isHome />
  <main>
    <Hero />
    <Features />
    <Screenshots />
    <Tutorials />
    <WhySotF />
    <Download />
    <Community />
  </main>
  <Footer />
</BaseLayout>
