---
const points = [
  '100% open source (GPL-3.0)',
  'Built in Rust — fast and reliable',
  'Science-based optimization',
  'Integrates spinorama.org speaker database',
  'Works with pro hardware (RME, Focusrite, USB)',
  'No subscription, no telemetry, no account',
];
---

<section class="py-24 px-4 sm:px-6 fade-section">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold text-fg mb-6">
          Built on science,<br />not guesswork
        </h2>
        <p class="text-fg-muted leading-relaxed">
          SotF uses peer-reviewed psychoacoustic research and measurement data
          to optimize your audio. Every EQ curve, every target function, every
          optimization algorithm is grounded in real science — not marketing
          claims or subjective tweaks.
        </p>
      </div>

      <ul class="space-y-4">
        {points.map((point) => (
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
            </svg>
            <span class="text-fg-secondary">{point}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
