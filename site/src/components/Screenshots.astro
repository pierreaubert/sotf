---
import pkg from '../../package.json';

// Screenshot assets live under /images/<major>.<minor>/ and are named with a
// matching v<major>.<minor> infix (e.g. /images/0.6/sotf-tui-v0.6-player.png).
// Patch bumps within the same minor reuse the same screenshots; a minor bump
// (0.6 → 0.7) picks up whichever directory has been added under public/images.
const majorMinor = pkg.version.split('.').slice(0, 2).join('.');
const imgBase = `/images/${majorMinor}`;
const v = `v${majorMinor}`;

const tuiScreenshots = [
  {
    src: `${imgBase}/sotf-tui-${v}-player.png`,
    alt: 'SotF Terminal — music player view',
    caption: 'Music player with library and queue',
  },
  {
    src: `${imgBase}/sotf-tui-${v}-plugins.png`,
    alt: 'SotF Terminal — plugin chain',
    caption: 'Plugin chain manager',
  },
  {
    src: `${imgBase}/sotf-tui-${v}-upmixer.png`,
    alt: 'SotF Terminal — upmixer plugin',
    caption: 'Stereo-to-surround upmixer',
  },
  {
    src: `${imgBase}/sotf-tui-${v}-headphone.png`,
    alt: 'SotF Terminal — headphone EQ',
    caption: 'Headphone EQ optimization',
  },
];

const gpuiScreenshots = [
  {
    src: `${imgBase}/sotf-gpui-${v}-player.png`,
    alt: 'SotF Desktop — player view',
    caption: 'Desktop player with library',
  },
  {
    src: `${imgBase}/sotf-gpui-${v}-eq.png`,
    alt: 'SotF Desktop — parametric EQ',
    caption: 'Visual parametric EQ editor',
  },
  {
    src: `${imgBase}/sotf-gpui-${v}-upmixer.png`,
    alt: 'SotF Desktop — upmixer',
    caption: 'Upmixer plugin in desktop app',
  },
  {
    src: `${imgBase}/sotf-${v}-headphoneeq.png`,
    alt: 'SotF — headphone EQ wizard',
    caption: 'Headphone EQ wizard',
  },
  {
    src: `${imgBase}/sotf-${v}-roomeq-mixedmode.png`,
    alt: 'SotF — room EQ wizard',
    caption: 'Room correction wizard',
  },
];
---

<section id="screenshots" class="py-24 px-4 sm:px-6 fade-section">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-bold text-fg text-center mb-4">Screenshots</h2>
    <p class="text-fg-muted text-center max-w-xl mx-auto mb-16">
      See SotF in action.
    </p>

    <!-- Terminal -->
    <div class="mb-16">
      <h3 class="text-lg font-semibold text-fg-secondary mb-6 flex items-center gap-2">
        <span class="px-2 py-0.5 text-xs font-mono rounded bg-accent/10 text-accent border border-accent/20">Terminal</span>
        Terminal Player
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {tuiScreenshots.map((shot) => (
          <figure class="group">
            <div class="overflow-hidden rounded-xl border border-border group-hover:border-accent/30 transition-all group-hover:shadow-[0_0_30px_var(--color-glow)]">
              <img src={shot.src} alt={shot.alt} class="w-full h-auto" loading="lazy" />
            </div>
            <figcaption class="mt-3 text-sm text-fg-subtle text-center">{shot.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- Desktop -->
    <div>
      <h3 class="text-lg font-semibold text-fg-secondary mb-6 flex items-center gap-2">
        <span class="px-2 py-0.5 text-xs font-mono rounded bg-accent/10 text-accent border border-accent/20">Desktop</span>
        Desktop App
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {gpuiScreenshots.map((shot) => (
          <figure class="group">
            <div class="overflow-hidden rounded-xl border border-border group-hover:border-accent/30 transition-all group-hover:shadow-[0_0_30px_var(--color-glow)]">
              <img src={shot.src} alt={shot.alt} class="w-full h-auto" loading="lazy" />
            </div>
            <figcaption class="mt-3 text-sm text-fg-subtle text-center">{shot.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
