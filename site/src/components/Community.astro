---
const links = [
  {
    title: 'Give Feedback',
    description: 'Share ideas and suggestions for improving SotF.',
    href: 'https://github.com/pierreaubert/sotf/discussions/116',
    cta: 'Join the discussion',
  },
  {
    title: 'Report a Bug',
    description: 'Found something broken? Let us know.',
    href: 'https://github.com/pierreaubert/sotf/discussions/117',
    cta: 'File a report',
  },
  {
    title: 'AudioScienceReview',
    description: 'Discussion on the ASR forum with fellow audiophiles.',
    href: 'https://www.audiosciencereview.com/forum/',
    cta: 'Visit the forum',
  },
];
---

<section id="community" class="py-24 px-4 sm:px-6 fade-section">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4">Community</h2>
    <p class="text-gray-400 text-center max-w-xl mx-auto mb-16">
      SotF is built in the open. Join the conversation.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group p-6 bg-card border border-border rounded-xl hover:border-accent/30 transition-colors"
        >
          <h3 class="text-white font-semibold mb-2">{link.title}</h3>
          <p class="text-sm text-gray-400 mb-4">{link.description}</p>
          <span class="text-sm text-accent group-hover:underline">{link.cta} &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
