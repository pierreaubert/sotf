[
  {
    "context": "PlayerView",
    "bindings": {
      "space": "player_ui::PlayPause",
      "n": "player_ui::NextTrack",
      ">": "player_ui::NextTrack",
      "b": "player_ui::PrevTrack",
      "<": "player_ui::PrevTrack",
      "s": "player_ui::Stop",
      "+": "player_ui::VolumeUp",
      "=": "player_ui::VolumeUp",
      "-": "player_ui::VolumeDown",
      "_": "player_ui::VolumeDown",

      "shift-l": "player_ui::SwitchToLibrary",
      "shift-q": "player_ui::SwitchToQueue",
      "shift-p": "player_ui::SwitchToPlugins",
      "shift-o": "player_ui::SwitchToDevices",
      "shift-d": "player_ui::SwitchToDirectoryManager",

      "/": "player_ui::ToggleSearch",
      "escape": "player_ui::Cancel",
      "t": "player_ui::ToggleLibraryView",
      "?": "player_ui::ToggleHelp",

      "s": "player_ui::CycleSortOrder",
      "1": "player_ui::SetSortArtist",
      "2": "player_ui::SetSortAlbum",
      "3": "player_ui::SetSortTitle",
      "4": "player_ui::SetSortYear",

      "c": "player_ui::CycleChannelFilter",
      "5": "player_ui::SetFilterAll",
      "6": "player_ui::SetFilterMono",
      "7": "player_ui::SetFilterStereo",
      "8": "player_ui::SetFilterMultichannel",
      "9": "player_ui::SetFilterMixed",

      "up": "player_ui::SelectPrev",
      "k": "player_ui::SelectPrev",
      "down": "player_ui::SelectNext",
      "j": "player_ui::SelectNext",
      "pageup": "player_ui::SelectPrevPage",
      "pagedown": "player_ui::SelectNextPage",

      "left": "player_ui::ToggleExpand",
      "h": "player_ui::ToggleExpand",
      "right": "player_ui::ToggleExpand",
      "l": "player_ui::ToggleExpand",

      "enter": "player_ui::Enter",
      "a": "player_ui::Enter"
    }
  }
]
