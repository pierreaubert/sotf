{
  "version": "1.1.0",
  "speakers": {
    "left": "left_lp0.csv",
    "lfe": "subwoofer_lp0.csv",
    "right": "right_lp0.csv"
  },
  "optimizer": {
    "mode": "iir",
    "loss_type": "flat",
    "algorithm": "autoeq:de",
    "num_filters": 7,
    "min_q": 0.5,
    "max_q": 10.0,
    "min_db": -12.0,
    "max_db": 12.0,
    "min_freq": 20.0,
    "max_freq": 500.0,
    "max_iter": 5000,
    "population": 300,
    "peq_model": "pk",
    "seed": 42,
    "refine": true,
    "local_algo": "cobyla",
    "psychoacoustic": true,
    "asymmetric_loss": true
  }
}