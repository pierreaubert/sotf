{
  "speakers": {
    "left": {
      "name": "left+lfe",
      "measurements": [
	"left_lp0.csv",
	"subwoofer_lp0.csv"
      ],
      "crossover": "left_crossovers"
    },
    "right": "right_lp0.csv"
  },
  "optimizer": {
    "mode": "iir",
    "loss_type": "flat",
    "algorithm": "autoeq:de",
    "num_filters": 7,
    "min_q": 0.5,
    "max_q": 4.0,
    "min_db": -12.0,
    "max_db": 6.0,
    "min_freq": 20.0,
    "max_freq": 16000.0,
    "max_iter": 15000,
    "population": 60,
    "peq_model": "pk",
    "seed": 42,
    "refine": true,
    "local_algo": "cobyla",
    "psychoacoustic": true,
    "asymmetric_loss": true
  },
  "group_delay": [],
  "crossovers": {
    "left_crossovers": {
      "type": "LR24",
      "frequency_range": [60.0, 120.0]
    }
  }
}
