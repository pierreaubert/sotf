{
  "embedding": {
    "provider": "openai",
    "model": "text-embedding-qwen3-embedding-8b",
    "base_url": "http://localhost:1234/v1"
  },
  "indexing": {
    "include": ["**/*.ts", "**/*.rs", "**/*.sh", "**/*.py", "**/*.swift"],
    "exclude": ["**/node_modules/**", "**/__pycache__/**", "**/target"]
  },
  "llm": {
    "provider": "claude-code-cli"
  },
  "debug": true
}
